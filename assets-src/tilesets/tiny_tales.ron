                     "crest",
                     "ra_wall_face", "ra_wall", "ra_tower", "ra_keep"],
            // What a map places by hand (ticket 1378): the lamps at Harl's
            // gate and the road bridge, a lit stone lamp two tiles tall,
            // (0, 16) of the jungle's animations over the tile below it.
            props: {
                "lamp": ("elv-games/tilesets/rogue-adventure/RA_Jungle_Animation.png", 256),
            },
            // The forest's trees (ticket 1356; 0096: trees by footprint):
            // ELV's animated green trees, the two wide ones, which fit a
            // crown of 3 x 3 tiles. Each sheet is 12 frames of 64 x 80 px,
            // four across; a frame's foot is where the roots meet the
            // ground. A big tree on each free 3 x 3 of forest, the same
            // frames halved on what is left. 160 ms a frame, as the river.
            trees: (
                of: ["forest"],
                sheets: [
                    "elv-games/tilesets/rogue-adventure/animated-trees/tree01_s_01_animation.png",
                    "elv-games/tilesets/rogue-adventure/animated-trees/tree02_s_01_animation.png",
                ],
                frame: (64, 80),
                frames: 12,
                ms: 160,
                foot: (32, 74),
            ),
        ),
        // A map outdoors (and any map that names no look): the World Map
        // set in its Standard colours. Walls, floors and doors are the
        // Dungeons set's.
        "outdoor": (
            layers: ["deep", "coast", "grass", "ice", "road", "floor", "ash", "forest",
