// Which bought Tiny Tales tiles the battle map's terrain is drawn with
// (ticket 0437, ADR-0052; `docs/design/look-and-feel.md` has it in words).
// Read by `cargo xtask tileset-import`, which packs these tiles into
// assets-private/game/tilesets/tiny_tales.png and writes tiny_tales.ron.
// Names and numbers only: the art itself is never in this repository.
//
// A tile is ("<sheet>", <id>): a sheet is a Tiled file of the bought
// tilesets (assets-private/library/tiny-tales/tilesets/<sheet>.tsx), an id
// counts its 16×16 tiles row by row from 0. A `Corners` layer names a
// Tiled "terrain" of a sheet instead: the sheet's own table gives the tile
// for each mix of corners. A `Block` layer names the top-left tile of
// nine (three by three) that draw a patch of the terrain with its edge on
// every side: each of our tiles is joined from their quarters.
(
    // Each of our terrains' own tile, painted first, unless a look below
    // has another. What stands on grass has the grass; water under a
    // bridge is water.
    terrain: {
        "plain": ("world-map/Set_A_Standard_Fields2", 89),
        "forest": ("world-map/Set_A_Standard_Fields2", 89),
        "thicket": ("world-map/Set_A_Standard_Fields2", 89),
        "mountain": ("world-map/Set_A_Standard_Fields2", 89),
        "peak": ("world-map/Set_A_Standard_Fields2", 89),
        "fort": ("world-map/Set_A_Standard_Fields2", 89),
        "burning": ("world-map/Set_A_Standard_Fields2", 89),
        "burnt": ("world-map/Set_A_Standard_Fields2", 89),
        "road": ("world-map/Set_A_Standard_Fields1", 41),
        "water": ("world-map/Set_A_Standard_Coast", 25),
        "bridge": ("world-map/Set_A_Standard_Coast", 25),
        "sea": ("world-map/Set_A_Standard_Coast", 218),
        "ice": ("world-map/Set_A_Standard_Fields1", 233),
        "floor": ("dungeons-1/Set_A_Fortress1", 161),
        "wall": ("dungeons-1/Set_E_Fortress1", 22),
        "door": ("dungeons-1/Set_E_Fortress1", 22),
        // Decoration (ticket 0733): the yard at Harrowby stands on grass
        // and on the yard's earth, the study's furniture on the floor and
        // the banner on the wall. The layers below draw them.
        "roof": ("world-map/Set_A_Standard_Fields2", 89),
        "house_wall": ("world-map/Set_A_Standard_Fields2", 89),
        "house_door": ("world-map/Set_A_Standard_Fields2", 89),
        "hedge": ("world-map/Set_A_Standard_Fields2", 89),
        "well": ("world-map/Set_A_Standard_Fields1", 41),
        "rack": ("world-map/Set_A_Standard_Fields1", 41),
        "desk": ("dungeons-1/Set_A_Fortress1", 161),
        "papers": ("dungeons-1/Set_A_Fortress1", 161),
        "shelf": ("dungeons-1/Set_A_Fortress1", 161),
        "rug": ("dungeons-1/Set_A_Fortress1", 161),
        "banner": ("dungeons-1/Set_E_Fortress1", 22),
    },
    // `full: false` leaves out the tile of all four corners: the layer's
    // terrains have it as their own tile already.
    layers: {
        // The deep sea's edge against shallow water.
        "deep": Corners(
            of: ["sea"],
            sheet: "world-map/Set_A_Standard_Coast", terrain: "Deep Water", full: false,
        ),
        // The shore: sand, then the wet band and the foam in the water's
        // tile. Drawn over the deep sea, so a beach has shallows.
        "coast": Corners(
            of: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "burning",
                 "burnt", "floor", "wall", "door", "roof", "house_wall", "house_door", "hedge",
                 "well", "rack", "desk", "papers", "shelf", "banner", "rug"],
            sheet: "world-map/Set_A_Standard_Coast", terrain: "Coast1", full: false,
        ),
        // The grass's edge, over the shore's sand and against walls.
        "grass": Corners(
            of: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "burning",
                 "burnt", "roof", "house_wall", "house_door", "hedge", "well", "rack"],
            sheet: "world-map/Set_A_Standard_Fields2", terrain: "Grass2", full: false,
        ),
        "ice": Corners(
            of: ["ice"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Snow 2", full: false,
        ),
        "road": Corners(
            of: ["road", "well", "rack"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Terrains2", full: false,
        ),
        // The floor's slabs end in a rim of the wall's bricks.
        "floor": Corners(
            of: ["floor", "desk", "papers", "shelf", "rug"],
            sheet: "dungeons-1/Set_A_Fortress1", terrain: "Floor2", full: false,
        ),
        // Burnt ground under the bare trees.
        "ash": Corners(
            of: ["burnt"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Grounds2",
        ),
        // Trees are a block of the sheet joined on each tile (ticket 0452):
        // a wood ends inside its own tiles, its edge whole trees, so the
        // ground beside it is never under a tree.
        "forest": Block(of: ["forest"], sheet: "world-map/Set_H_Trees1", block: 5),
        "thicket": Block(of: ["thicket"], sheet: "world-map/Set_H_Trees6", block: 13),
        "burnt": Block(of: ["burnt"], sheet: "world-map/Set_H_Trees3", block: 13),
        // Nothing in the bundle burns: the forest's trees recoloured in
        // the palette's fire colour.
        "burning": Block(of: ["burning"], sheet: "world-map/Set_H_Trees1", block: 5, tint: "fire"),
        // The sheet has two tiles for some mixes; the second is the one
        // whose edge ends where the tile does.
        "mountain": Corners(
            of: ["mountain"],
            sheet: "world-map/Set_F_Mountains", terrain: "Grasslands Mountain", pick: 1,
        ),
        "peak": Corners(
            of: ["peak"],
            sheet: "world-map/Set_F_Mountains", terrain: "Ruin Mountains", pick: 1,
        ),
        // A bridge runs left to right, unless the water is to its left
        // and its right: then it runs up and down.
        "bridge": Tiles(
            of: ["bridge"],
            tile: ("world-map/Set_B_World", 169),
            beside: ["water", "sea", "ice"],
            sides: {
                ".#.#": ("world-map/Set_B_World", 168),
                "##.#": ("world-map/Set_B_World", 168),
                ".###": ("world-map/Set_B_World", 168),
                "####": ("world-map/Set_B_World", 168),
            },
        ),
        "fort": Tiles(of: ["fort"], tile: ("world-map/Set_C_Icons", 214)),
        "door": Tiles(of: ["door"], tile: ("dungeons-1/Set_A_Fortress1", 27)),
        // Indoors the floor runs under the pools, and a pool has a stone
        // rim on the sides where it ends (up, right, down, left).
        "indoor_floor": Corners(
            of: ["floor", "water", "sea", "bridge", "ice", "desk", "papers", "shelf", "rug"],
            sheet: "dungeons-1/Set_A_Fortress1", terrain: "Floor2", full: false,
        ),
        "pool": Tiles(
            of: ["water", "sea", "bridge"],
            tile: ("dungeons-1/Set_A_Fortress1", 65),
            beside: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "burning",
                     "burnt", "floor", "wall", "door"],
            sides: {
                "#...": ("dungeons-1/Set_A_Fortress1", 49),
                ".#..": ("dungeons-1/Set_A_Fortress1", 66),
                "..#.": ("dungeons-1/Set_A_Fortress1", 81),
                "...#": ("dungeons-1/Set_A_Fortress1", 64),
                "#..#": ("dungeons-1/Set_A_Fortress1", 48),
                "##..": ("dungeons-1/Set_A_Fortress1", 50),
                "..##": ("dungeons-1/Set_A_Fortress1", 80),
                ".##.": ("dungeons-1/Set_A_Fortress1", 82),
            },
        ),
        // The yard at Harrowby (0733), from the Overworld set: the back
        // of the lead's rented house (Small Village), its roof and its
        // plank wall each a patch with its edges where it ends, the door
        // over the wall with its lintel on the tile above.
        "roof": Tiles(
            of: ["roof"],
            tile: ("overworld/Set_E_Small_Village1", 33),
            beside: ["roof"],
            sides: {
                ".##.": ("overworld/Set_E_Small_Village1", 16),
                ".###": ("overworld/Set_E_Small_Village1", 17),
                "..##": ("overworld/Set_E_Small_Village1", 18),
                "###.": ("overworld/Set_E_Small_Village1", 32),
                "#.##": ("overworld/Set_E_Small_Village1", 34),
                "##..": ("overworld/Set_E_Small_Village1", 32),
                "##.#": ("overworld/Set_E_Small_Village1", 33),
                "#..#": ("overworld/Set_E_Small_Village1", 34),
            },
        ),
        "house_wall": Tiles(
            of: ["house_wall", "house_door"],
            tile: ("overworld/Set_E_Small_Village1", 113),
            beside: ["house_wall", "house_door"],
            sides: {
                ".##.": ("overworld/Set_E_Small_Village1", 96),
                ".###": ("overworld/Set_E_Small_Village1", 97),
                "..##": ("overworld/Set_E_Small_Village1", 98),
                "###.": ("overworld/Set_E_Small_Village1", 112),
                "#.##": ("overworld/Set_E_Small_Village1", 114),
                "##..": ("overworld/Set_E_Small_Village1", 128),
                "##.#": ("overworld/Set_E_Small_Village1", 129),
                "#..#": ("overworld/Set_E_Small_Village1", 130),
            },
        ),
        // Tile 7 is empty: only the wall tile above a door has the lintel.
        "lintel": Tiles(
            of: ["house_wall"],
            tile: ("overworld/Set_E_Small_Village1", 7),
            beside: ["house_door"],
            sides: { "..#.": ("overworld/Set_E_Small_Village1", 200) },
        ),
        "house_door": Tiles(of: ["house_door"], tile: ("overworld/Set_E_Small_Village1", 216)),
        // The Exteriors set: a bush for each tile of the hedge, the stone
        // well, and the dungeon set's weapon rack for the practice swords.
        "hedge": Tiles(of: ["hedge"], tile: ("overworld/Set_B_Exteriors", 2)),
        "well": Tiles(of: ["well"], tile: ("overworld/Set_B_Exteriors", 156)),
        "rack": Tiles(of: ["rack"], tile: ("overworld/Set_D_Interiors", 193)),
        // The study at Veyne Hall (0733), from the Overworld set's
        // furniture: a wooden table, papers on it, bookshelves two tiles
        // wide and a blue rug. The bundle has no banner: a pale blue
        // valance (Interiors) hangs on the wall, House Veyne's shield
        // (Interiors) on its middle tile, a tile empty elsewhere (7).
        "desk": Block(of: ["desk", "papers"], sheet: "overworld/Set_F_Tables", block: 0),
        "papers": Tiles(of: ["papers"], tile: ("overworld/Set_D_Interiors", 145)),
        "shelf": Tiles(
            of: ["shelf"],
            tile: ("overworld/Set_C_Interiors", 12),
            beside: ["shelf"],
            sides: { "...#": ("overworld/Set_C_Interiors", 13) },
        ),
        "rug": Block(of: ["rug"], sheet: "overworld/Set_G_Carpet", block: 69),
        "banner": Tiles(
            of: ["banner"],
            tile: ("overworld/Set_C_Interiors", 133),
            beside: ["banner"],
            sides: {
                ".#..": ("overworld/Set_C_Interiors", 132),
                "...#": ("overworld/Set_C_Interiors", 134),
            },
        ),
        "crest": Tiles(
            of: ["banner"],
            tile: ("overworld/Set_E_Small_Village1", 7),
            beside: ["banner"],
            sides: { ".#.#": ("overworld/Set_D_Interiors", 42) },
        ),
    },
    looks: {
        // A map outdoors (and any map that names no look): the World Map
        // set in its Standard colours. Walls, floors and doors are the
        // Dungeons set's.
        "outdoor": (
            layers: ["deep", "coast", "grass", "ice", "road", "floor", "ash", "forest",
                     "thicket", "burnt", "burning", "mountain", "peak", "bridge", "fort", "door",
                     "roof", "house_wall", "lintel", "house_door", "hedge", "well", "rack",
                     "desk", "papers", "shelf", "rug", "banner", "crest"],
        ),
        // A map indoors: the Dungeons set (Fortress). Water is a pool in
        // the floor; the terrains the set lacks keep their outdoor
        // pictures.
        "indoor": (
            terrain: {
                "water": ("dungeons-1/Set_A_Fortress1", 65),
                "sea": ("dungeons-1/Set_A_Fortress1", 65),
                "bridge": ("dungeons-1/Set_A_Fortress1", 65),
            },
            layers: ["indoor_floor", "pool", "grass", "ice", "road", "ash", "forest",
                     "thicket", "burnt", "burning", "mountain", "peak", "bridge", "fort", "door",
                     "roof", "house_wall", "lintel", "house_door", "hedge", "well", "rack",
                     "desk", "papers", "shelf", "rug", "banner", "crest"],
        ),
    },
)
