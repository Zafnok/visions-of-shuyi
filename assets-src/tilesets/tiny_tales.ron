// Which bought Tiny Tales tiles the battle map's terrain is drawn with
// (ticket 0437, ADR-0052; `docs/design/look-and-feel.md` has it in words).
// Read by `cargo xtask tileset-import`, which packs these tiles into
// assets-private/game/tilesets/tiny_tales.png and writes tiny_tales.ron.
// Names and numbers only: the art itself is never in this repository.
//
// A tile is ("<sheet>", <id>): a sheet is a Tiled file of the bought
// tilesets (assets-private/library/tiny-tales/tilesets/<sheet>.tsx), an id
// counts its 16×16 tiles row by row from 0. A `Corners` layer names a
// Tiled "terrain" of a sheet instead: the sheet's own table gives the tile
// for each mix of corners. A `Block` layer names the top-left tile of
// nine (three by three) that draw a patch of the terrain with its edge on
// every side: each of our tiles is joined from their quarters.
//
// A sheet ending in `.png` is a plain sheet of another bought pack, by its
// path under assets-private/library/ (ELV Games' Rogue Adventure has no
// Tiled files, ticket 1318). Its ids count its 16×16 tiles the same way.
// A `Patch` layer is a terrain joined at corners from the usual layout: a
// patch of nine whose top-left tile it names, and nine more with the
// inside corners. `moving` makes every packed tile of a sheet loop: frame
// k is the tile `k × step` places to its right.
//
// A `Quarters` layer (ticket 1359) is joined at corners too, each picture
// from four quarters of a kit's cells, RPG Maker style: a tile's quarter
// is an outside corner, an edge, an inside corner or nothing, by its two
// neighbours that way and the diagonal, so every corner is round. Cells
// are counted as tiles are. `recolour` changes colours of a sheet as it
// is read (the art is never recoloured by hand or committed recoloured).
// With a `face` (ticket 1361) each picture also hangs the cliff's face on
// the tile below the layer's bottom edge, its ends where the layer ends
// beside the tile above, and `skip` names terrains its pictures leave
// alone; a `Shadow` layer is a faced layer's pictures as silhouettes in
// one colour (and alpha), moved by `offset` pixels.
(
    // Each of our terrains' own tile, painted first, unless a look below
    // has another. What stands on grass has the grass; water under a
    // bridge is water.
    terrain: {
        "plain": ("world-map/Set_A_Standard_Fields2", 89),
        "forest": ("world-map/Set_A_Standard_Fields2", 89),
        "thicket": ("world-map/Set_A_Standard_Fields2", 89),
        "mountain": ("world-map/Set_A_Standard_Fields2", 89),
        "peak": ("world-map/Set_A_Standard_Fields2", 89),
        "fort": ("world-map/Set_A_Standard_Fields2", 89),
        "house": ("world-map/Set_A_Standard_Fields2", 89),
        "gate": ("world-map/Set_A_Standard_Fields2", 89),
        "burning": ("world-map/Set_A_Standard_Fields2", 89),
        "burnt": ("world-map/Set_A_Standard_Fields2", 89),
        "road": ("world-map/Set_A_Standard_Fields1", 41),
        "water": ("world-map/Set_A_Standard_Coast", 25),
        "bridge": ("world-map/Set_A_Standard_Coast", 25),
        "sea": ("world-map/Set_A_Standard_Coast", 218),
        "ice": ("world-map/Set_A_Standard_Fields1", 233),
        "floor": ("dungeons-1/Set_A_Fortress1", 161),
        "throne": ("dungeons-1/Set_A_Fortress1", 161),
        "wall": ("dungeons-1/Set_E_Fortress1", 22),
        "door": ("dungeons-1/Set_E_Fortress1", 22),
        // Decoration (ticket 0733): the yard (`harrowby_yard`) stands on grass
        // and on the yard's earth, the study's furniture on the floor and
        // the banner on the wall. The layers below draw them.
        "roof": ("world-map/Set_A_Standard_Fields2", 89),
        "house_wall": ("world-map/Set_A_Standard_Fields2", 89),
        "house_door": ("world-map/Set_A_Standard_Fields2", 89),
        "hedge": ("world-map/Set_A_Standard_Fields2", 89),
        "well": ("world-map/Set_A_Standard_Fields1", 41),
        "rack": ("world-map/Set_A_Standard_Fields1", 41),
        "desk": ("dungeons-1/Set_A_Fortress1", 161),
        "papers": ("dungeons-1/Set_A_Fortress1", 161),
        "shelf": ("dungeons-1/Set_A_Fortress1", 161),
        "rug": ("dungeons-1/Set_A_Fortress1", 161),
        "banner": ("dungeons-1/Set_E_Fortress1", 22),
    },
    // `full: false` leaves out the tile of all four corners: the layer's
    // terrains have it as their own tile already.
    layers: {
        // Rogue Adventure (Chapter 1's look, ticket 1318). The forest floor:
        // its patch from (9, 4), its inside corners from (9, 1).
        "ra_forest_floor": Patch(
            of: ["forest"],
            sheet: "elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png",
            patch: 109, inside: 34, full: false,
        ),
        // The river and its banks: its patch from (0, 12), its inside
        // corners from (0, 9); it moves (`moving`, below).
        "ra_river": Patch(
            of: ["water", "sea", "bridge"],
            sheet: "elv-games/tilesets/rogue-adventure/RA_Animated_Water.png",
            patch: 384, inside: 288, full: false,
        ),
        // Chapter 1's hills and peaks (ticket 1359, 0096's answer): one
        // raised area with a rim of stones round it, Electric Lemon's
        // Lonesome Forest cliff kit (7 cells across), recoloured below. The
        // outside corners (0, 3), (3, 3), (0, 6), (3, 6); the edges along
        // the top (1, 3) and the bottom with its shade (1, 6), down the
        // left (0, 4) and the right (3, 4); the inside corners are the
        // kit's lobes, (1, 0) above and (1, 2) below. The hill's top is
        // the plain's own grass. Its cliff face (ticket 1361) hangs on the
        // tile below its bottom edge, the kit's row 8: its left end (0, 8),
        // its middle (2, 8), its right end (3, 8); never on a wall
        // (Chapter 1's top-right hills stand on the fort's).
        "lf_rim": Quarters(
            of: ["mountain", "peak"],
            sheet: "electric-lemon/tilesets/lonesome-forest/Summer Tileset/Lonesome_Forest_WALLS_and_CLIFF_EDGES.png",
            kit: (outer: (21, 24, 42, 45), across: (22, 43), down: (28, 31), inside: (1, 1, 15, 15)),
            face: (left: 56, middle: 58, right: 59),
            skip: ["wall"],
        ),
        // The soft shadow under the rim and the face (1361, 0096's
        // mockups): their shape, a dark green at alpha 70, a pixel right
        // and three down.
        "lf_shadow": Shadow(of: "lf_rim", colour: (12, 18, 8, 70), offset: (1, 3)),
        // The peaks' dark rock mass, under the rim: RA_Overworld_Ground.png
        // (30 tiles across), its patch from (21, 17), its inside corners
        // from (21, 14), over the grass.
        "ra_peak": Patch(
            of: ["peak"],
            sheet: "elv-games/tilesets/rogue-adventure/RA_Overworld_Ground.png",
            patch: 531, inside: 441,
        ),
        // A plank bridge, (30, 39) of the jungle's sheet.
        "ra_bridge": Tiles(
            of: ["bridge"], tile: ("elv-games/tilesets/rogue-adventure/RA_Jungle.png", 1278),
        ),
        // The deep sea's edge against shallow water.
        "deep": Corners(
            of: ["sea"],
            sheet: "world-map/Set_A_Standard_Coast", terrain: "Deep Water", full: false,
        ),
        // The shore: sand, then the wet band and the foam in the water's
        // tile. Drawn over the deep sea, so a beach has shallows.
        "coast": Corners(
            of: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "house",
                 "gate", "throne", "burning", "burnt", "floor", "wall", "door", "roof",
                 "house_wall", "house_door", "hedge", "well", "rack", "desk", "papers", "shelf",
                 "banner", "rug"],
            sheet: "world-map/Set_A_Standard_Coast", terrain: "Coast1", full: false,
        ),
        // The grass's edge, over the shore's sand and against walls.
        "grass": Corners(
            of: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "house",
                 "gate", "burning", "burnt", "roof", "house_wall", "house_door", "hedge", "well",
                 "rack"],
            sheet: "world-map/Set_A_Standard_Fields2", terrain: "Grass2", full: false,
        ),
        "ice": Corners(
            of: ["ice"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Snow 2", full: false,
        ),
        "road": Corners(
            of: ["road", "well", "rack", "bridge"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Terrains2", full: false,
        ),
        // The floor's slabs end in a rim of the wall's bricks.
        "floor": Corners(
            of: ["floor", "throne", "desk", "papers", "shelf", "rug"],
            sheet: "dungeons-1/Set_A_Fortress1", terrain: "Floor2", full: false,
        ),
        // Burnt ground under the bare trees.
        "ash": Corners(
            of: ["burnt"],
            sheet: "world-map/Set_A_Standard_Fields1", terrain: "Grounds2",
        ),
        // Trees are a block of the sheet joined on each tile (ticket 0452):
        // a wood ends inside its own tiles, its edge whole trees, so the
        // ground beside it is never under a tree.
        "forest": Block(of: ["forest"], sheet: "world-map/Set_H_Trees1", block: 5),
        "thicket": Block(of: ["thicket"], sheet: "world-map/Set_H_Trees6", block: 13),
        "burnt": Block(of: ["burnt"], sheet: "world-map/Set_H_Trees3", block: 13),
        // Nothing in the bundle burns: the forest's trees recoloured in
        // the palette's fire colour.
        "burning": Block(of: ["burning"], sheet: "world-map/Set_H_Trees1", block: 5, tint: "fire"),
        // The sheet has two tiles for some mixes; the second is the one
        // whose edge ends where the tile does.
        "mountain": Corners(
            of: ["mountain"],
            sheet: "world-map/Set_F_Mountains", terrain: "Grasslands Mountain", pick: 1,
        ),
        "peak": Corners(
            of: ["peak"],
            sheet: "world-map/Set_F_Mountains", terrain: "Ruin Mountains", pick: 1,
        ),
        // A bridge runs left to right, unless the water is to its left
        // and its right: then it runs up and down.
        "bridge": Tiles(
            of: ["bridge"],
            tile: ("world-map/Set_B_World", 169),
            beside: ["water", "sea", "ice"],
            sides: {
                ".#.#": ("world-map/Set_B_World", 168),
                "##.#": ("world-map/Set_B_World", 168),
                ".###": ("world-map/Set_B_World", 168),
                "####": ("world-map/Set_B_World", 168),
            },
        ),
        "fort": Tiles(of: ["fort"], tile: ("world-map/Set_C_Icons", 214)),
        "door": Tiles(of: ["door"], tile: ("dungeons-1/Set_A_Fortress1", 27)),
        // Stand-ins (ticket 0322) until ticket 0471 finds better pictures:
        // the World Map set's small house (the bundle's are "too
        // modern/nice", Nick), the Fortress set's open archway
        // ("serviceable") and, as the bundle has no throne, a chair.
        "house": Tiles(of: ["house"], tile: ("world-map/Set_C_Icons", 0)),
        "gate": Tiles(of: ["gate"], tile: ("dungeons-1/Set_A_Fortress1", 26)),
        "throne": Tiles(of: ["throne"], tile: ("overworld/Set_C_Interiors", 205)),
        // Indoors the floor runs under the pools, and a pool has a stone
        // rim on the sides where it ends (up, right, down, left).
        "indoor_floor": Corners(
            of: ["floor", "throne", "water", "sea", "bridge", "ice", "desk", "papers", "shelf",
                 "rug"],
            sheet: "dungeons-1/Set_A_Fortress1", terrain: "Floor2", full: false,
        ),
        "pool": Tiles(
            of: ["water", "sea", "bridge"],
            tile: ("dungeons-1/Set_A_Fortress1", 65),
            beside: ["plain", "road", "forest", "thicket", "mountain", "peak", "fort", "house",
                     "gate", "throne", "burning", "burnt", "floor", "wall", "door"],
            sides: {
                "#...": ("dungeons-1/Set_A_Fortress1", 49),
                ".#..": ("dungeons-1/Set_A_Fortress1", 66),
                "..#.": ("dungeons-1/Set_A_Fortress1", 81),
                "...#": ("dungeons-1/Set_A_Fortress1", 64),
                "#..#": ("dungeons-1/Set_A_Fortress1", 48),
                "##..": ("dungeons-1/Set_A_Fortress1", 50),
                "..##": ("dungeons-1/Set_A_Fortress1", 80),
                ".##.": ("dungeons-1/Set_A_Fortress1", 82),
            },
        ),
        // The yard, `harrowby_yard` (0733), from the Overworld set: the back
        // of the lead's rented house (Small Village), its roof and its
        // plank wall each a patch with its edges where it ends, the door
        // over the wall with its lintel on the tile above.
        "roof": Tiles(
            of: ["roof"],
            tile: ("overworld/Set_E_Small_Village1", 33),
            beside: ["roof"],
            sides: {
                ".##.": ("overworld/Set_E_Small_Village1", 16),
                ".###": ("overworld/Set_E_Small_Village1", 17),
                "..##": ("overworld/Set_E_Small_Village1", 18),
                "###.": ("overworld/Set_E_Small_Village1", 32),
                "#.##": ("overworld/Set_E_Small_Village1", 34),
                "##..": ("overworld/Set_E_Small_Village1", 32),
                "##.#": ("overworld/Set_E_Small_Village1", 33),
                "#..#": ("overworld/Set_E_Small_Village1", 34),
            },
        ),
        "house_wall": Tiles(
            of: ["house_wall", "house_door"],
            tile: ("overworld/Set_E_Small_Village1", 113),
            beside: ["house_wall", "house_door"],
            sides: {
                ".##.": ("overworld/Set_E_Small_Village1", 96),
                ".###": ("overworld/Set_E_Small_Village1", 97),
                "..##": ("overworld/Set_E_Small_Village1", 98),
                "###.": ("overworld/Set_E_Small_Village1", 112),
                "#.##": ("overworld/Set_E_Small_Village1", 114),
                "##..": ("overworld/Set_E_Small_Village1", 128),
                "##.#": ("overworld/Set_E_Small_Village1", 129),
                "#..#": ("overworld/Set_E_Small_Village1", 130),
            },
        ),
        // Tile 7 is empty: only the wall tile above a door has the lintel.
        "lintel": Tiles(
            of: ["house_wall"],
            tile: ("overworld/Set_E_Small_Village1", 7),
            beside: ["house_door"],
            sides: { "..#.": ("overworld/Set_E_Small_Village1", 200) },
        ),
        "house_door": Tiles(of: ["house_door"], tile: ("overworld/Set_E_Small_Village1", 216)),
        // The Exteriors set: a bush for each tile of the hedge, the stone
        // well, and the dungeon set's weapon rack for the practice swords.
        "hedge": Tiles(of: ["hedge"], tile: ("overworld/Set_B_Exteriors", 2)),
        "well": Tiles(of: ["well"], tile: ("overworld/Set_B_Exteriors", 156)),
        "rack": Tiles(of: ["rack"], tile: ("overworld/Set_D_Interiors", 193)),
        // The study, `veyne_study` (0733), from the Overworld set's
        // furniture: a wooden table, papers on it, bookshelves two tiles
        // wide and a blue rug. The bundle has no banner: a pale blue
        // valance (Interiors) hangs on the wall, House Veyne's shield
        // (Interiors) on its middle tile, a tile empty elsewhere (7).
        "desk": Block(of: ["desk", "papers"], sheet: "overworld/Set_F_Tables", block: 0),
        "papers": Tiles(of: ["papers"], tile: ("overworld/Set_D_Interiors", 145)),
        "shelf": Tiles(
            of: ["shelf"],
            tile: ("overworld/Set_C_Interiors", 12),
            beside: ["shelf"],
            sides: { "...#": ("overworld/Set_C_Interiors", 13) },
        ),
        "rug": Block(of: ["rug"], sheet: "overworld/Set_G_Carpet", block: 69),
        "banner": Tiles(
            of: ["banner"],
            tile: ("overworld/Set_C_Interiors", 133),
            beside: ["banner"],
            sides: {
                ".#..": ("overworld/Set_C_Interiors", 132),
                "...#": ("overworld/Set_C_Interiors", 134),
            },
        ),
        "crest": Tiles(
            of: ["banner"],
            tile: ("overworld/Set_E_Small_Village1", 7),
            beside: ["banner"],
            sides: { ".#.#": ("overworld/Set_D_Interiors", 42) },
        ),
    },
    // Chapter 1 (ticket 1318, 0096's answer): ELV Games' Rogue Adventure.
    // RA_Ground_Tiles.png is 25 tiles across, RA_Animated_Water.png and
    // RA_Jungle.png 32. The river's 8 frames are 4 tiles apart, 160 ms
    // each (as 0096's mockups ran them).
    moving: {
        "elv-games/tilesets/rogue-adventure/RA_Animated_Water.png": (frames: 8, step: 4, ms: 160),
    },
    // Lonesome Forest's four stone colours (PICO-8's) in a sandy brown
    // (0096: "two shades lighter" than the first brown shown).
    recolour: {
        "electric-lemon/tilesets/lonesome-forest/Summer Tileset/Lonesome_Forest_WALLS_and_CLIFF_EDGES.png": [
            ((0, 0, 0), (64, 51, 37)),
            ((29, 43, 83), (106, 84, 61)),
            ((95, 87, 79), (150, 118, 86)),
            ((131, 118, 156), (184, 148, 110)),
        ],
    },
    looks: {
        // Chapter 1's map: Rogue Adventure's grass, the darker forest
        // floor joined at corners, roads as whole dirt tiles that never
        // taper, the moving river joined at its banks, plank bridges;
        // hills and peaks as one raised area with a round rim, the peaks'
        // rock inside it (1359), the cliff's face below and its shadow
        // (1361). The fort (1360) and the trees (1356) keep
        // Tiny Tales' pictures until their tickets, over this ground.
        "rogue_adventure": (
            terrain: {
                // The grass, (2, 5); the forest floor's middle, (10, 5).
                "plain": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "forest": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 135),
                "thicket": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "mountain": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "peak": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "fort": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "house": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "gate": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "burning": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "burnt": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "roof": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "house_wall": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "house_door": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                "hedge": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 127),
                // The dirt, (2, 13).
                "road": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 327),
                "well": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 327),
                "rack": ("elv-games/tilesets/rogue-adventure/RA_Ground_Tiles.png", 327),
                // The river's middle, (1, 13): water under a bridge is water.
                "water": ("elv-games/tilesets/rogue-adventure/RA_Animated_Water.png", 417),
                "sea": ("elv-games/tilesets/rogue-adventure/RA_Animated_Water.png", 417),
                "bridge": ("elv-games/tilesets/rogue-adventure/RA_Animated_Water.png", 417),
            },
            layers: ["ra_forest_floor", "ra_river", "ice", "floor", "ash", "ra_peak", "lf_shadow",
                     "lf_rim", "forest", "thicket", "burnt", "burning", "ra_bridge", "fort", "house",
                     "gate", "throne", "door", "roof", "house_wall", "lintel", "house_door", "hedge",
                     "well", "rack", "desk", "papers", "shelf", "rug", "banner", "crest"],
        ),
        // A map outdoors (and any map that names no look): the World Map
        // set in its Standard colours. Walls, floors and doors are the
        // Dungeons set's.
        "outdoor": (
            layers: ["deep", "coast", "grass", "ice", "road", "floor", "ash", "forest",
                     "thicket", "burnt", "burning", "mountain", "peak", "bridge", "fort", "house",
                     "gate", "throne", "door", "roof", "house_wall", "lintel", "house_door",
                     "hedge", "well", "rack", "desk", "papers", "shelf", "rug", "banner", "crest"],
        ),
        // A map indoors: the Dungeons set (Fortress). Water is a pool in
        // the floor; the terrains the set lacks keep their outdoor
        // pictures.
        "indoor": (
            terrain: {
                "water": ("dungeons-1/Set_A_Fortress1", 65),
                "sea": ("dungeons-1/Set_A_Fortress1", 65),
                "bridge": ("dungeons-1/Set_A_Fortress1", 65),
            },
            layers: ["indoor_floor", "pool", "grass", "ice", "road", "ash", "forest",
                     "thicket", "burnt", "burning", "mountain", "peak", "bridge", "fort", "house",
                     "gate", "throne", "door", "roof", "house_wall", "lintel", "house_door",
                     "hedge", "well", "rack", "desk", "papers", "shelf", "rug", "banner", "crest"],
        ),
    },
)
