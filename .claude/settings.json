{
  "env": {
    "MCP_TIMEOUT": "300000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          },
          {
            "type": "command",
            "if": "PowerShell(gh pr create*)",
            "command": "cargo xtask pr-size --hook",
            "timeout": 180,
            "statusMessage": "Measuring the PR's size"
          }
        ]
      }
    ]
  }
}
