// One-time tips (ticket 0406, docs/design/chapter-1.md "Teaching"): each is
// shown once per profile, the first time its trigger happens in a battle.
// Text is at most 3 lines of 60 characters; {Action} is replaced with the
// key bound to that action (e.g. {Confirm}), {Cursor} with the keys that
// move the cursor, and {Select} with the key that picks on the map (Confirm's
// while Select has no key; controls.md, Optional split keys), so rebinding
// stays correct.
//
// Triggers: FirstBattleStart, FirstUnitSelected, FirstEnemyInRange,
// FirstForecast, FirstLowHp, FirstLevelUp, FirstEnemyPhase,
// DangerZoneAvailable, FirstSkillUnit (a unit with a skill is selected),
// FirstCaster (the action menu opens for a unit that knows a spell),
// FirstTerrain (the cursor rests on a tile that isn't plain ground). At
// most one tip per trigger.
//
// The battle menu's Guides lists every tip, in this order, after the
// lessons (ticket 0458).
//
// The guide speaks every tip (docs/design/tutorial.md, The guide): `face:
// "<expression>"` picks the guide's expression while it shows, `smile` if
// none. It must be one of the guide's portrait (portraits/guide.ron, in the
// bought art).
(
    tips: [
        (
            id: "battle_start",
            trigger: FirstBattleStart,
            title: "Your move",
            text: "Over to you. Steer the cursor with {Cursor}; {Select} on\none of your units picks it up. Press {NextUnit} for whoever\ncan still act, and {Info} for what you're working with.",
            face: "neutral",
        ),
        (
            id: "unit_selected",
            trigger: FirstUnitSelected,
            title: "Moving a unit",
            text: "Blue is where it can go, red is where it can attack.\nSteer to a blue tile and press {Select} to send it there.\nChanged your mind? {Cancel} backs out.",
            face: "neutral",
        ),
        (
            id: "enemy_in_range",
            trigger: FirstEnemyInRange,
            title: "Enemy in reach",
            text: "That enemy on a red tile? This unit can reach it this\nturn. Move into range, then pick Attack from the menu.",
            face: "sly",
        ),
        (
            id: "forecast",
            trigger: FirstForecast,
            title: "Attack forecast",
            text: "Read this before you swing: damage, hit chance, and who\nstrikes first. Pick the target with {Cursor}, attack with\n{Confirm}. Backing out with {Cancel} doesn't spend the turn.",
            face: "thinking",
        ),
        (
            id: "low_hp",
            trigger: FirstLowHp,
            title: "Low HP",
            text: "One of yours is badly hurt. Pull it back, or have it\ndrink a Potion from its item menu. And if that was a\nmistake, {Rewind} can undo it.",
            face: "stern",
        ),
        (
            id: "level_up",
            trigger: FirstLevelUp,
            title: "Level up!",
            text: "Nice. Fighting earns EXP, and at 100 a unit gains a level\nand its stats can grow. See what changed with {Info}.",
            face: "smile",
        ),
        (
            id: "enemy_phase",
            trigger: FirstEnemyPhase,
            title: "Enemy phase",
            text: "Their turn: the enemy moves and attacks. Watch closely,\nit tells you where the danger is. Press {Confirm} to skip\nthe banner.",
            face: "stern",
        ),
        (
            id: "danger_zone",
            trigger: DangerZoneAvailable,
            title: "Danger zone",
            text: "Want to know where it's safe? Press {DangerZone} to tint\nevery tile the enemy could hit next turn, and again to\nhide it. Press {Select} on one enemy for just its range.",
            face: "sly",
        ),
        (
            id: "skills",
            trigger: FirstSkillUnit,
            title: "Skills",
            text: "This one has skills. Passive ones just work; an active\none is used from Arts or Skill in the action menu. Press\n{Info} for the full list and what each one does.",
            face: "thinking",
        ),
        (
            id: "magic",
            trigger: FirstCaster,
            title: "Magic",
            text: "A spellcaster. Pick Magic in the action menu to cast at\nan enemy or heal an ally. Each spell has only a few uses\nper battle; {Info} shows how many are left.",
            face: "neutral",
        ),
        (
            id: "terrain",
            trigger: FirstTerrain,
            title: "Terrain",
            text: "Mind the ground. The side panel shows the DEF and AVO a\nunit gets standing here. Some tiles cost more movement\nto cross, and some can't be crossed at all.",
            face: "thinking",
        ),
    ],
)
