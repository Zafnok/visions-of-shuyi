// One-time tips (ticket 0406, docs/design/chapter-1.md "Teaching"): each is
// shown once per profile, the first time its trigger happens in a battle.
//
// `text` is what the guide says: at most 3 lines of 60 characters. She is
// voiced (ticket 0475) and a clip can't say a key the player rebound, so
// the text names no key, and still teaches something on its own. `how`
// (optional) is the instructions shown under it: at most 3 lines of 60
// characters, where {Action} is replaced with the key bound to that action
// (e.g. {Confirm}), {Cursor} with the keys that move the cursor, and
// {Select} with the key that picks on the map (Confirm's while Select has
// no key; controls.md, Optional split keys), so rebinding stays correct.
//
// Triggers: FirstBattleStart, FirstUnitSelected, FirstEnemyInRange,
// FirstForecast, FirstLowHp, FirstLevelUp, FirstEnemyPhase,
// DangerZoneAvailable, FirstSkillUnit (a unit with a skill is selected),
// FirstCaster (the action menu opens for a unit that knows a spell),
// FirstTerrain (the cursor rests on a tile that isn't plain ground),
// ZoomAvailable (browsing a map whose look can zoom, with no lesson in play),
// FirstWadeInReach (a selected unit's move range has a `water` tile: a foot
// or flying unit, never a mounted or armored one), FirstEffective (the
// forecast is open and a strike of either side is effective by its weapon
// kind: a spear on a mounted unit, a bow on a flying one; not a spell on an
// element its target is Weak to). Outside battle (ticket 0874): FirstLoadGame
// (the Load Game list opens with a save in it), FirstProfileScreen (the
// Profile screen opens); not where saves can't be exported (the Playdate).
// At most one tip per trigger.
//
// How a tip is put away (ticket 0495, docs/design/tutorial.md "How a tip
// box is put away"): in battle it takes the keys until Confirm or Cancel
// closes it, a press made while it is up. It comes up in its moment, or,
// if it missed it (behind a lesson, another tip or a screen), only on the
// map with no menu open; after a tip is closed, a lesson is done or a
// screen the player opened goes, the next waits for a press on the map.
//
// The battle menu's Guides lists every tip, in this order, after the
// lessons (ticket 0458).
//
// The guide speaks every tip (docs/design/tutorial.md, The guide): `face:
// "<expression>"` picks the guide's expression while it shows, `smile` if
// none. It must be one of the guide's portrait (portraits/guide.ron, in the
// bought art).
(
    tips: [
        (
            id: "battle_start",
            trigger: FirstBattleStart,
            title: "Your move",
            text: "Over to you. Steer the cursor onto one of your units and\npick it up. You can jump straight to whoever can still act,\nand look anyone over to see what you're working with.",
            how: "Move the cursor: {Cursor}. Pick up a unit: {Select}\nNext unit to act: {NextUnit}. A unit's details: {Info}",
            face: "neutral",
        ),
        (
            id: "zoom",
            trigger: ZoomAvailable,
            title: "Zooming the map",
            text: "Can't see it all? The view scrolls with your cursor, and\nthe map zooms in or out. Zoom again to switch back.",
            how: "Zoom the map in or out: {ZoomMap}",
            face: "sly",
        ),
        (
            id: "unit_selected",
            trigger: FirstUnitSelected,
            title: "Moving a unit",
            text: "Blue is where it can go, red is where it can attack.\nSteer to a blue tile and send it there. Changed your\nmind? You can back out.",
            how: "Send it to a blue tile: {Select}. Back out: {Cancel}",
            face: "neutral",
        ),
        (
            id: "enemy_in_range",
            trigger: FirstEnemyInRange,
            title: "Enemy in reach",
            text: "That enemy on a red tile? This unit can reach it this\nturn. Move into range, then pick Attack from the menu.",
            face: "sly",
        ),
        (
            id: "forecast",
            trigger: FirstForecast,
            title: "Attack forecast",
            text: "Read this before you swing: damage, hit chance, and who\nstrikes first. Pick your target and attack, or back out;\nbacking out doesn't spend the turn.",
            how: "Pick the target: {Cursor}. Attack: {Confirm}\nBack out: {Cancel}",
            face: "thinking",
        ),
        (
            id: "low_hp",
            trigger: FirstLowHp,
            title: "Low HP",
            text: "One of yours is badly hurt. Pull it back, or have it\ndrink a Potion from its item menu. And if that was a\nmistake, Rewind can undo it.",
            how: "Rewind: {Rewind}",
            face: "stern",
        ),
        (
            id: "level_up",
            trigger: FirstLevelUp,
            title: "Level up!",
            text: "Nice. Fighting earns EXP, and at 100 a unit gains a level\nand its stats can grow. Look it over to see what changed.",
            how: "A unit's details: {Info}",
            face: "smile",
        ),
        (
            id: "enemy_phase",
            trigger: FirstEnemyPhase,
            title: "Enemy phase",
            text: "Their turn: the enemy moves and attacks. Watch closely,\nit tells you where the danger is. The banner can be\nskipped.",
            how: "Skip the banner: {Confirm}",
            face: "stern",
        ),
        (
            id: "danger_zone",
            trigger: DangerZoneAvailable,
            title: "Danger zone",
            text: "Want to know where it's safe? The danger zone tints every\ntile the enemy could hit next turn. Pick one enemy instead\nfor just its range.",
            how: "Danger zone on or off: {DangerZone}\nOne enemy's range: {Select} on it",
            face: "sly",
        ),
        (
            id: "skills",
            trigger: FirstSkillUnit,
            title: "Skills",
            text: "This one has skills. Passive ones just work; an active\none is used from Arts or Skill in the action menu. Its\ndetails list them all, and what each one does.",
            how: "A unit's details: {Info}",
            face: "thinking",
        ),
        (
            id: "magic",
            trigger: FirstCaster,
            title: "Magic",
            text: "A spellcaster. Pick Magic in the action menu to cast at\nan enemy or heal an ally. Each spell has only a few uses\nper battle; its details show how many are left.",
            how: "A unit's details: {Info}",
            face: "neutral",
        ),
        (
            id: "terrain",
            trigger: FirstTerrain,
            title: "Terrain",
            text: "Mind the ground. The side panel shows the DEF and AVO a\nunit gets standing here. Some tiles cost more movement\nto cross, and some can't be crossed at all.",
            face: "thinking",
        ),
        (
            id: "wading",
            trigger: FirstWadeInReach,
            title: "Wading",
            text: "Foot units can wade a river, but each tile of water costs\n5 Mov, most of a turn. Riders and armor can't go in.\nIn the water, a unit gets +10 AVO and no DEF bonus.",
            face: "thinking",
        ),
        (
            id: "weapon_kinds",
            trigger: FirstEffective,
            title: "Weapon kinds",
            text: "A spear's might counts double against riders, a bow's
triple against fliers, yours and theirs alike. A ! in
the forecast means it's working; a unit's details say more.",
            face: "sly",
        ),
        (
            id: "export_save",
            trigger: FirstLoadGame,
            title: "Exporting a save",
            text: "Any save on this list can go out to a file of its own:
a copy to keep, or to play on another computer.",
            how: "Export the save under the cursor: {Info}",
            face: "smile",
        ),
        (
            id: "export_profile",
            trigger: FirstProfileScreen,
            title: "Exporting a profile",
            text: "A profile can go out to a file of its own, with all its
saves, options and keys: handy for a new computer.",
            how: "Export the profile under the cursor: {Info}",
            face: "smile",
        ),
    ],
)
