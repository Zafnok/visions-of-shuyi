// One-time tips (ticket 0406, docs/design/chapter-1.md "Teaching"): each is
// shown once per profile, the first time its trigger happens in a battle.
// Text is at most 3 lines of 60 characters; {Action} is replaced with the
// key bound to that action (e.g. {Confirm}), {Cursor} with the keys that
// move the cursor, and {Select} with the key that picks on the map (Confirm's
// while Select has no key; controls.md, Optional split keys), so rebinding
// stays correct.
//
// Triggers: FirstBattleStart, FirstUnitSelected, FirstEnemyInRange,
// FirstForecast, FirstLowHp, FirstLevelUp, FirstEnemyPhase,
// DangerZoneAvailable, FirstSkillUnit (a unit with a skill is selected),
// FirstCaster (the action menu opens for a unit that knows a spell),
// FirstTerrain (the cursor rests on a tile that isn't plain ground). At
// most one tip per trigger.
//
// The battle menu's Guides lists every tip, in this order, after the
// lessons (ticket 0458).
//
// The guide speaks every tip (docs/design/tutorial.md, The guide): `face:
// "<expression>"` picks the guide's expression while it shows, `smile` if
// none. It must be one of the guide's portrait (portraits/guide.ron, in the
// bought art).
(
    tips: [
        (
            id: "battle_start",
            trigger: FirstBattleStart,
            title: "Your move",
            text: "Steer the cursor with {Cursor}. Press {Select} on one of\nyour units to select it. {NextUnit} jumps to the next unit\nthat can still act; {Info} shows a unit's details.",
        ),
        (
            id: "unit_selected",
            trigger: FirstUnitSelected,
            title: "Moving a unit",
            text: "Blue tiles are where it can move, red where it can\nattack. Steer to a blue tile and press {Select} to move;\n{Cancel} backs out.",
        ),
        (
            id: "enemy_in_range",
            trigger: FirstEnemyInRange,
            title: "Enemy in reach",
            text: "A red tile holds an enemy this unit can attack after\nmoving. Move there, then pick Attack from the menu.",
        ),
        (
            id: "forecast",
            trigger: FirstForecast,
            title: "Attack forecast",
            text: "The panel shows damage, hit chance and who strikes\nfirst. {Cursor} picks the target, {Confirm} attacks,\n{Cancel} goes back without spending the turn.",
        ),
        (
            id: "low_hp",
            trigger: FirstLowHp,
            title: "Low HP",
            text: "A unit is badly hurt. Pull it back, or use a Potion\nfrom its item menu. {Rewind} undoes a mistake.",
        ),
        (
            id: "level_up",
            trigger: FirstLevelUp,
            title: "Level up!",
            text: "Fighting earns EXP. At 100 EXP a unit gains a level and\nits stats can grow. Check the new numbers with {Info}.",
        ),
        (
            id: "enemy_phase",
            trigger: FirstEnemyPhase,
            title: "Enemy phase",
            text: "Now the enemy moves and attacks. Watch what they do:\nit shows where the danger is. {Confirm} skips the banner.",
        ),
        (
            id: "danger_zone",
            trigger: DangerZoneAvailable,
            title: "Danger zone",
            text: "Press {DangerZone} to tint every tile the enemy could hit\nnext turn. Press it again to hide it. {Select} on an enemy\nshows just its range.",
        ),
        (
            id: "skills",
            trigger: FirstSkillUnit,
            title: "Skills",
            text: "This unit has skills. Passive ones work on their own;
an active one is used from Arts or Skill in the action
menu. {Info} lists them all and what each does.",
        ),
        (
            id: "magic",
            trigger: FirstCaster,
            title: "Magic",
            text: "This unit knows spells. Pick Magic in the action menu to
cast at an enemy or to heal an ally. Each spell has a
few uses per battle; {Info} shows how many are left.",
        ),
        (
            id: "terrain",
            trigger: FirstTerrain,
            title: "Terrain",
            text: "Terrain matters. The side panel shows the DEF and AVO a
unit gets standing on this tile. Some tiles take more
movement to cross, and some can't be crossed at all.",
        ),
    ],
)
