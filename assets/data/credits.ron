// Credits for third-party works that aren't music or sounds (ticket 0808).
// The music and sound credits are in assets/audio/audio.ron and are never
// repeated here; the credits screen shows both. Loaded and validated by
// trpg_content::credits.
//
// Every row of THIRD_PARTY_ASSETS.md needs an entry in one of the two files
// with the same source link (a test checks it). `hidden: true` keeps an
// entry off the credits screen: use it only for software plumbing the
// player never sees or hears. Hidden works are still listed in
// THIRD_PARTY_ASSETS.md and ship with their license texts.
//
// Bought art (ADR-0032, ADR-0051) has `private: [...]`: the files of
// assets-private/game/ the credit covers, each a path there or the start
// of one. Its license is "Custom (<seller>)". The entry shows only in a
// build that has those files. Every bought file needs one: `cargo xtask
// private-assets --pin` refuses a file no entry covers, so a ticket that
// puts new bought files in the game adds their path here (and their
// artist to `author`) in the same PR. Keep the paths narrow, so new art
// can't slip in under an old entry.
(
    credits: [
        (id: "terminus", group: Fonts, title: "Terminus Font", author: "Dimitar Toshkov Zhekov",
         source: "https://terminus-font.sourceforge.net/", license: "OFL-1.1"),
        // The chapter title card's lettering (0812, ADR-0128).
        (id: "cinzel", group: Fonts, title: "Cinzel", author: "Natanael Gama",
         source: "https://github.com/NDISCOVER/Cinzel", license: "OFL-1.1"),

        // The bought Tiny Tales bundle (THIRD_PARTY_ASSETS.md): the map
        // sprites (0436), the two test portraits (0711), the terrain tiles
        // (0437; the tilesets' artist is Rayane Félix; the Overworld set's
        // for Chapter 1's places, 0733, are in the same packed image) and
        // the Chapter 1 cast's portraits (0706: four heroes' busts, and seven faces made
        // with the bundle's Character Generator EX, whose parts are Rayane
        // Félix's), and the combat scene's pictures and backdrops (0413:
        // still battle pictures of *Heroes: A New Beginning*, *Battlers 5:
        // Faith and Evil* and *Battlers 2: Elemental Forces*, and
        // *Battlebacks Vol.1*), and the title screen's backdrops (0811:
        // seven more pictures of *Battlebacks Vol.1*), and the guide's face
        // in the tip box (0455: the Fox Miko hero of *Heroes 2: Rebellious
        // Souls*), and Joss's face and map sprite (0858: the Thief hero).
        (id: "tiny_tales", group: Art, title: "Tiny Tales",
         author: "Megatiles (artists: Rayane Félix, Lunatic Red, Kodots Games Studio)",
         source: "https://megatiles.itch.io/", license: "Custom (Megatiles)",
         private: [
            "battlebacks/",
            "battlers/archer.", "battlers/cleric.", "battlers/exile.",
            "battlers/fire_elemental.", "battlers/frost_elemental.", "battlers/guard.",
            "battlers/heretic.", "battlers/lead_f.", "battlers/mage.", "battlers/poacher.",
            "battlers/retainer.",
            "portraits/guide/", "portraits/guide.ron",
            "portraits/defector", "portraits/heretic", "portraits/keeper", "portraits/lead_f", "portraits/lead_m",
            "portraits/messenger", "portraits/poacher", "portraits/red_captain",
            "portraits/retainer", "portraits/rival", "portraits/sergeant", "portraits/soldier",
            "portraits/test_knight", "portraits/test_lord",
            "tilesets/tiny_tales.png", "tilesets/tiny_tales.ron", "title/",
            // The map sprites, but the riders (MattWalkden's, below).
            "units/adventurer_m1.", "units/archer.", "units/church_cleric.",
            "units/church_knight.", "units/fighter_female.", "units/fighter_m1.",
            "units/fighter_male.", "units/fire_elemental.", "units/ice_elemental.",
            "units/knight_m1.", "units/thief.", "units/warrior_m1.", "units/witch.",
            "worldmaps/act1.png",
         ]),

        // Shironejiya's free battle pictures (0413): the Brigand, the Raider
        // and the red captain in the combat scene; Joss recoloured (0858). Its terms ask for the site's name,
        // its address and the no-reuse line in a text shipped with the
        // game: this entry is that text (the site's name is written in
        // kanji, which the font doesn't have: THIRD_PARTY_ASSETS.md).
        (id: "shironejiya", group: Art,
         title: "Shironejiya battle pictures (the materials in this game may not be reused)",
         author: "Shironejiya (Shiro Nejiya)",
         source: "http://hi79.web.fc2.com/", license: "Custom (Shironejiya)",
         private: ["battlers/brigand.", "battlers/defector.", "battlers/raider.", "battlers/red_captain."]),

        // Pixel Flag's Paladin (0446): the riders in the combat scene, the
        // enemy's and Tamsin's, recoloured. Bought on BOOTH; its terms ask
        // for no credit, but every bought work has one (THIRD_PARTY_ASSETS.md).
        (id: "pixel_flag", group: Art,
         title: "Classes and Mobs pixel-art TRPG pieces",
         author: "Pixel Flag",
         source: "https://booth.pm/ja/items/7851483", license: "Custom (Pixel Flag)",
         private: ["battlers/rider.", "battlers/sergeant."]),

        // MattWalkden's riders (0499): the mounted classes' map sprites,
        // cut to the game's walking sheet. Pay what you want on itch.io;
        // no credit asked, but every bought work has one.
        (id: "mattwalkden", group: Art,
         title: "Fantasy Battle Pack",
         author: "MattWalkden",
         source: "https://mattwalkden.itch.io/fantasy-battle-pack", license: "Custom (MattWalkden)",
         private: ["units/lance_cavalier.", "units/mounted_archer."]),

        // The title screen's campfire (0922).
        (id: "idylwild_campfires", group: Art, title: "Idylwild's Chromatic Campfires",
         author: "Idylwild", source: "https://opengameart.org/content/idylwilds-chromatic-campfires",
         license: "CC0-1.0"),

        // The AI voice tools that made the voice clips (0722, ADR-0107).
        // Hidden from the list: the credits screen shows them under its
        // own heading, with the line that the voices are AI-generated,
        // only when the game found clips (trpg_content::credits::VOICE_TOOLS).
        // The clips are in the private repository's voice/ folder.
        (id: "qwen3_tts", group: Software, title: "Qwen3-TTS", author: "the Qwen team, Alibaba Cloud",
         source: "https://github.com/QwenLM/Qwen3-TTS", license: "Apache-2.0", hidden: true),
        (id: "chatterbox", group: Software, title: "Chatterbox", author: "Resemble AI",
         source: "https://github.com/resemble-ai/chatterbox", license: "MIT", hidden: true),

        // The web build's JavaScript loaders (web/README.md).
        (id: "mq_js_bundle", group: Software, title: "macroquad JS/WASM loader", author: "not-fl3",
         source: "https://github.com/not-fl3/macroquad/blob/5e9b5ca912ac65962c05c0da842a4a70eaae34b9/js/mq_js_bundle.js",
         license: "MIT", hidden: true),
        (id: "sapp_jsutils", group: Software, title: "sapp-jsutils", author: "not-fl3",
         source: "https://github.com/not-fl3/sapp-jsutils", license: "MIT", hidden: true),
        // The table of controller button layouts inside the gilrs crate.
        (id: "sdl_gamecontrollerdb", group: Software, title: "SDL_GameControllerDB",
         author: "Sam Lantinga and the SDL_GameControllerDB contributors",
         source: "https://github.com/mdqinc/SDL_GameControllerDB", license: "Zlib", hidden: true),
        // The Playdate SDK's start-up file, linked into the Playdate game (1031).
        (id: "playdate_setup_c", group: Software, title: "Playdate SDK build support (setup.c)",
         author: "Panic Inc.", source: "https://play.date/dev/", license: "0BSD", hidden: true),
    ],
)
