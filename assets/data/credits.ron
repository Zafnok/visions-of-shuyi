// Credits for third-party works that aren't music or sounds (ticket 0808).
// The music and sound credits are in assets/audio/audio.ron and are never
// repeated here; the credits screen shows both. Loaded and validated by
// trpg_content::credits.
//
// Every row of THIRD_PARTY_ASSETS.md needs an entry in one of the two files
// with the same source link (a test checks it). `hidden: true` keeps an
// entry off the credits screen: use it only for software plumbing the
// player never sees or hears. Hidden works are still listed in
// THIRD_PARTY_ASSETS.md and ship with their license texts.
//
// Bought art (ADR-0032, ADR-0051) has `private: [...]`: the files of
// assets-private/game/ the credit covers, each a path there or the start
// of one. Its license is "Custom (<seller>)". The entry shows only in a
// build that has those files. Every bought file needs one: `cargo xtask
// private-assets --pin` refuses a file no entry covers, so a ticket that
// puts new bought files in the game adds their path here (and their
// artist to `author`) in the same PR. Keep the paths narrow, so new art
// can't slip in under an old entry.
(
    credits: [
        (id: "terminus", group: Fonts, title: "Terminus Font", author: "Dimitar Toshkov Zhekov",
         source: "https://terminus-font.sourceforge.net/", license: "OFL-1.1"),

        // The bought Tiny Tales bundle (THIRD_PARTY_ASSETS.md): the map
        // sprites (0436), the two test portraits (0711), the terrain tiles
        // (0437; the tilesets' artist is Rayane Félix) and the Chapter 1
        // cast's portraits (0706: four heroes' busts, and seven faces made
        // with the bundle's Character Generator EX, whose parts are Rayane
        // Félix's), and the combat scene's pictures and backdrops (0413:
        // still battle pictures of *Heroes: A New Beginning*, *Battlers 5:
        // Faith and Evil* and *Battlers 2: Elemental Forces*, and
        // *Battlebacks Vol.1*).
        (id: "tiny_tales", group: Art, title: "Tiny Tales",
         author: "Megatiles (artists: Rayane Félix, Lunatic Red, Kodots Games Studio)",
         source: "https://megatiles.itch.io/", license: "Custom (Megatiles)",
         private: [
            "battlebacks/",
            "battlers/archer.", "battlers/cleric.", "battlers/exile.",
            "battlers/fire_elemental.", "battlers/frost_elemental.", "battlers/guard.",
            "battlers/heretic.", "battlers/lead_f.", "battlers/mage.",
            "portraits/heretic", "portraits/keeper", "portraits/lead_f", "portraits/lead_m",
            "portraits/messenger", "portraits/poacher", "portraits/red_captain",
            "portraits/retainer", "portraits/rival", "portraits/sergeant", "portraits/soldier",
            "portraits/test_knight", "portraits/test_lord",
            "tilesets/tiny_tales.png", "tilesets/tiny_tales.ron", "units/",
         ]),

        // Shironejiya's free battle pictures (0413): the Brigand, the Raider
        // and Harl in the combat scene. Its terms ask for the site's name,
        // its address and the no-reuse line in a text shipped with the
        // game: this entry is that text (the site's name is written in
        // kanji, which the font doesn't have: THIRD_PARTY_ASSETS.md).
        (id: "shironejiya", group: Art,
         title: "Shironejiya battle pictures (the materials in this game may not be reused)",
         author: "Shironejiya (Shiro Nejiya)",
         source: "http://hi79.web.fc2.com/", license: "Custom (Shironejiya)",
         private: ["battlers/brigand.", "battlers/raider.", "battlers/red_captain."]),

        // The web build's JavaScript loaders (web/README.md).
        (id: "mq_js_bundle", group: Software, title: "macroquad JS/WASM loader", author: "not-fl3",
         source: "https://github.com/not-fl3/macroquad/blob/5e9b5ca912ac65962c05c0da842a4a70eaae34b9/js/mq_js_bundle.js",
         license: "MIT", hidden: true),
        (id: "quad_storage_js", group: Software, title: "quad-storage JS plugin", author: "optozorax",
         source: "https://github.com/optozorax/quad-storage/blob/3760b953aec17d65cc4ca8edfa39c38e7337ec3a/js/quad-storage.js",
         license: "MIT", hidden: true),
        (id: "sapp_jsutils", group: Software, title: "sapp-jsutils", author: "not-fl3",
         source: "https://github.com/not-fl3/sapp-jsutils", license: "MIT", hidden: true),
        // The table of controller button layouts inside the gilrs crate.
        (id: "sdl_gamecontrollerdb", group: Software, title: "SDL_GameControllerDB",
         author: "Sam Lantinga and the SDL_GameControllerDB contributors",
         source: "https://github.com/mdqinc/SDL_GameControllerDB", license: "Zlib", hidden: true),
    ],
)
