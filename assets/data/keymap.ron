// Key bindings: the two layouts' default keys from docs/design/controls.md.
// The player picks a layout on first launch and can rebind every action but
// Debug (their keys are saved separately, per layout; ADR-0031). Screens only
// see the action names on the left; each maps to a list of key chords. In
// every layout, every action must be listed (use [] to leave one unbound),
// with at most 3 chords (the player's 3 key slots, filled in this order; the
// first is the one help text shows), and a chord may be bound to only one
// action of each key group. DialogueLog is in a group of its own, so it may
// share a chord with an action of the rest (controls.md, Dialogue log).
//
// Esc and Delete are fixed and may not appear anywhere in this file: Esc
// always cancels (in every layout and the layout picker) and Delete empties
// a key slot on the Key bindings screen. "Shift+Escape" and "Shift+Delete"
// are ordinary chords. See controls.md, Rebinding keys.
//
// Each layout has an id (the name the player's saved settings know it by;
// never rename one), name (the text key of the name the layout picker shows)
// and keys. The layout picker lists the layouts in this order.
//
// layout_picker holds the keys that work before a layout is chosen (the
// first-launch picker), so it can be used with either hand. Only the actions
// listed there are bound; the rest do nothing until a layout is picked. It
// isn't rebindable, so the 3-chord limit doesn't apply there.
//
// Chords: lowercase letters "a".."z", digits "0".."9", punctuation as
// itself ";" "," "." "/" "'" "[" "]" "\\" "-" "=" "`", "Up" "Down" "Left"
// "Right" "Enter" "Space" "Tab" "Backspace" "Insert" "Home" "End" "PageUp"
// "PageDown" "F1".."F12", numpad "Kp0".."Kp9" "Kp+" "Kp-" "Kp*" "Kp/" "Kp.",
// optionally prefixed by "Shift+". "Shift+e" and "e" are different chords.
(
    layouts: [
        // Arrows steer; the left hand acts from the A S D F row.
        (
            id: "RightHanded",
            name: "layout_picker.right_handed",
            keys: {
                // Held arrow keys repeat.
                "CursorLeft": ["Left"],
                "CursorDown": ["Down"],
                "CursorUp": ["Up"],
                "CursorRight": ["Right"],

                // Hold Confirm to fast-forward text and animations.
                "Confirm": ["f"],
                // With nothing to cancel it opens the map menu. Esc also cancels
                // (a fixed key, not listed here).
                "Cancel": ["d"],
                "PrevUnit": ["a"],
                "NextUnit": ["s"],
                "Info": ["e"],
                "DangerZone": ["w"],
                // Space opens the end-turn prompt; Space again confirms it.
                "EndTurn": ["Space"],
                "ToggleAutoEnd": ["Shift+Space"],
                // Opened by Cancel with nothing to cancel, or Confirm on an empty tile.
                "Menu": [],
                "Debug": ["F2"],
                // Opens the turn rewind during the player phase.
                "Rewind": ["r"],
                // Optional split keys, unbound by default (controls.md,
                // Optional split keys): Select picks on the map instead of
                // Confirm; ConfirmEndTurn accepts the end-turn prompt instead of
                // End turn pressed again.
                "Select": [],
                "ConfirmEndTurn": [],
                // Switches the battle map between 1x and 2x (pictures only).
                "ZoomMap": ["q"],
                // Opens the dialogue log while a scene plays. Its own key group.
                "DialogueLog": ["b"],
                // The Playdate's crank (ticket 1035): only its playdate
                // table below binds them; the Key bindings screen doesn't
                // list them.
                "RewindBack": [],
                "RewindForward": [],
                // Opens Options where a menu has it. Never a key: only the
                // Playdate's system menu sends it.
                "Options": [],
                // The world map's shortcuts (ticket 1007): the cursor to
                // the army, and the Find list. Their own key group.
                "WorldArmy": ["c"],
                "WorldFind": ["x"],
            },
        ),
        // W A S D steer; the right hand acts from the J K L ; row, a finger
        // for finger mirror of RightHanded.
        (
            id: "LeftHanded",
            name: "layout_picker.left_handed",
            keys: {
                "CursorLeft": ["a"],
                "CursorDown": ["s"],
                "CursorUp": ["w"],
                "CursorRight": ["d"],

                "Confirm": ["j"],
                "Cancel": ["k"],
                "PrevUnit": [";"],
                "NextUnit": ["l"],
                "Info": ["i"],
                "DangerZone": ["o"],
                "EndTurn": ["Space"],
                "ToggleAutoEnd": ["Shift+Space"],
                "Menu": [],
                "Debug": ["F2"],
                "Rewind": ["u"],
                "Select": [],
                "ConfirmEndTurn": [],
                "ZoomMap": ["p"],
                "DialogueLog": ["n"],
                "RewindBack": [],
                "RewindForward": [],
                "Options": [],
                "WorldArmy": [","],
                "WorldFind": ["."],
            },
        ),
    ],
    // Before a layout is chosen: either hand's up/down and confirm keys.
    // Nothing but the fixed Esc cancels, and the picker ignores it (a layout
    // must be picked).
    layout_picker: {
        "CursorUp": ["Up", "w"],
        "CursorDown": ["Down", "s"],
        "Confirm": ["f", "j", "Enter", "Space"],
    },
    // Controller buttons (controls.md, Controller): one table for both
    // layouts and the layout picker, with the same rules as a layout (every
    // action listed, at most 3 buttons, a button on only one action of each
    // key group). Debug and Options have no button and must stay []. Buttons are named by position on an
    // Xbox-shaped pad, whatever is printed on them: "South" "East" "West"
    // "North" (the face buttons), "LeftShoulder" "RightShoulder"
    // "LeftTrigger" "RightTrigger", "Select" (the left centre button, Back)
    // "Start", "LeftStickPress" "RightStickPress", "DpadUp" "DpadDown"
    // "DpadLeft" "DpadRight", and each stick's directions "LeftStickUp"
    // "LeftStickDown" "LeftStickLeft" "LeftStickRight" "RightStickUp" ...,
    // and a crank wound one notch "CrankBack" "CrankForward" (the Playdate's).
    // On Switch-style pads South and East swap, so the button labelled A
    // confirms there too.
    pad: {
        // D-pad and left stick both move the cursor; held, they repeat.
        "CursorLeft": ["DpadLeft", "LeftStickLeft"],
        "CursorDown": ["DpadDown", "LeftStickDown"],
        "CursorUp": ["DpadUp", "LeftStickUp"],
        "CursorRight": ["DpadRight", "LeftStickRight"],

        "Confirm": ["South"],
        "Cancel": ["East"],
        "PrevUnit": ["LeftShoulder"],
        "NextUnit": ["RightShoulder"],
        "Info": ["North"],
        "DangerZone": ["West"],
        // Start opens the end-turn prompt; Start again confirms it.
        "EndTurn": ["Start"],
        "ToggleAutoEnd": ["Select"],
        "Menu": [],
        "Debug": [],
        "Rewind": ["LeftTrigger"],
        "Select": [],
        "ConfirmEndTurn": [],
        "ZoomMap": ["RightTrigger"],
        // The left face button, like Danger zone: another key group.
        "DialogueLog": ["West"],
        "RewindBack": [],
        "RewindForward": [],
        "Options": [],
        // The world map's group (ticket 1007): Unit info's and Danger
        // zone's buttons, which the world map doesn't use.
        "WorldArmy": ["North"],
        "WorldFind": ["West"],
    },
    // The Playdate's buttons (docs/design/playdate.md, Buttons and the
    // crank), in place of `pad` on a Playdate: the D-pad, A (South) and B
    // (East). Two buttons joined by + are pressed together: A + B ends
    // the turn, hold B + left / right picks the previous / next unit. The
    // crank wound back opens the rewind and steps it back, wound forwards
    // steps it towards the present. The shortcuts it has no button for are
    // in the map menu and its system menu (ticket 1035).
    playdate: {
        "CursorLeft": ["DpadLeft"],
        "CursorDown": ["DpadDown"],
        "CursorUp": ["DpadUp"],
        "CursorRight": ["DpadRight"],

        "Confirm": ["South"],
        "Cancel": ["East"],
        "EndTurn": ["South+East"],
        "PrevUnit": ["East+DpadLeft"],
        "NextUnit": ["East+DpadRight"],
        "Info": [],
        "DangerZone": [],
        "ToggleAutoEnd": [],
        "Menu": [],
        "Debug": [],
        "Rewind": [],
        "Select": [],
        "ConfirmEndTurn": [],
        "ZoomMap": [],
        "DialogueLog": [],
        "RewindBack": ["CrankBack"],
        "RewindForward": ["CrankForward"],
        "Options": [],
        "WorldArmy": [],
        "WorldFind": [],
    },
    // Held cursor keys and buttons, in every layout and the layout picker:
    // first repeat after delay_ms, then every interval_ms.
    repeat: (delay_ms: 300, interval_ms: 55),
    // Two buttons pressed together (the playdate table's A + B): a button
    // that starts a chord holds back its own action until its partner
    // comes, at most window_ms (or until it is let go). Tunable.
    chord: (window_ms: 80),
    // A stick counts as a held direction once pushed press_percent of the
    // way, and stops below release_percent (lower, so a stick resting near
    // the edge doesn't flicker). Tunable.
    stick: (press_percent: 50, release_percent: 35),
    // The Playdate's crank: one notch (one CrankBack or CrankForward) per
    // notch_degrees wound. Tunable.
    crank: (notch_degrees: 30),
)
