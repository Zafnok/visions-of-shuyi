// The public stand-in of the lessons (ticket 0160, ADR-0117). The game's own
// file is in the private repository's content/, laid over this one by every
// build that has it checked out. A build without it (a fork) reads this:
// every lesson, without notes (the tutorial).
//
// Checklist lessons (ticket 0456, docs/design/tutorial.md "The lessons"):
// the guide's box with a list of things to do, ticked as the player does
// them, in any order. The lesson closes when every item is ticked; while it
// is open the turn can't end (unless an item is `TurnEnded`). Each lesson
// shows once per campaign, the first time its trigger happens in a battle,
// one at a time: lessons started by the same trigger come in file order.
// A lesson box takes no keys and has nothing to dismiss: the battle works
// under it and it closes itself. The next lesson follows a done one at
// once; the tips that fired meanwhile wait until a lesson run is over and
// the player is back on the map (ticket 0495). The box at the end of the
// lessons takes the keys and waits for a press on the map after the last
// lesson, like a tip.
// A lesson is only up when a unit still to act that turn could do what it
// asks (ticket 0464): attack (ForecastOpened, Attacked) needs one that could
// reach an enemy, ArtsOpened one with an art it could use from a tile it can
// reach, TileAimed one that could aim a spell at a tile, the other unit items
// any unit. One whose turn to open comes when nobody can doesn't open, and
// waits for its trigger to fire again, that turn or later. One open is put
// away the moment nobody left can, and comes back the next time its trigger
// fires in a later turn.
//
// Fields:
//   id        snake_case; the campaign keeps it once the lesson is done.
//   level     Full (shows only at Full) or Short (at Full and Short).
//   trigger   what starts it: a tip trigger (tips.ron), e.g.
//             FirstBattleStart, or one only lessons use: NoUnitLeft (every
//             unit has acted), SecondTurn (turn 2's player phase),
//             ThreatArrowsShown, ArtsAvailable (an action menu with Arts
//             that can be used), TileSpellAvailable (a spell list with a
//             spell that can be cast on a tile from there).
//   battles   optional: the battle ids it may start in (any if left out).
//   title     the heading, at most 30 characters.
//   text      what the guide says: 1 or 2 lines of at most 60 characters.
//             The story's keep to 45 (labels to 41), so the box with the
//             guide's face stays over the map, off the side panel. She is
//             voiced (ticket 0475) and a clip can't say a key the player
//             rebound, so the text names no key: keys go in the items. It
//             still teaches something on its own.
//   items     the objectives: 1 to 6 of (label: "...", done_when: ...); a
//             label is one line of at most 56 characters. Two items can't
//             share a done_when.
//   face      optional: the guide's expression, `smile` if left out.
//
// {Action} in labels is replaced with the key bound to that action
// (e.g. {Confirm}), {Cursor} with the keys that move the cursor, {Select}
// with the key that picks on the map, as in tips.ron.
//
// done_when: Pressed("<Action>") (the battle used that action, e.g.
// Pressed("CursorUp"), Pressed("Info"), Pressed("NextUnit")), CursorMoved
// (any way), UnitSelected, UnitMoved (where the unit goes was picked),
// ActionMenuOpened, ArtsOpened, ForecastOpened, Attacked, TileAimed (a spell
// aimed at a tile), ThreatPointed / SafePointed (a selected unit's path
// pointed at a tile with / without threat arrows), RewindOpened,
// RewindClosed, OptionsOpened, TurnEnded.
//
// The lessons (ticket 0457): basic controls at Full, what is different in
// this game at Short. The test lesson is in assets-test/data/lessons.ron.
(
    lessons: [
        (
            id: "cursor",
            level: Full,
            trigger: FirstBattleStart,
            title: "Moving the cursor",
            text: "That's your cursor. It picks tiles and units.\nOne tile each way, so you know the feel.",
            face: "neutral",
            items: [
                (label: "Move it up: {CursorUp}", done_when: Pressed("CursorUp")),
                (label: "Move it down: {CursorDown}", done_when: Pressed("CursorDown")),
                (label: "Move it left: {CursorLeft}", done_when: Pressed("CursorLeft")),
                (label: "Move it right: {CursorRight}", done_when: Pressed("CursorRight")),
            ],
        ),
        (
            id: "keys",
            level: Short,
            trigger: FirstBattleStart,
            title: "Played on the keys",
            text: "No mouse here; it's all keys. And every key\ncan be changed in Options, if you'd rather.",
            face: "sly",
            items: [
                (label: "Move the cursor: {Cursor}", done_when: CursorMoved),
                (label: "Open Options from the map menu: {Cancel}", done_when: OptionsOpened),
            ],
        ),
        (
            id: "next_unit",
            level: Full,
            trigger: FirstBattleStart,
            title: "Finding your units",
            text: "No need to hunt for who's left to move. Jump\nstraight to them, and look anyone over.",
            face: "neutral",
            items: [
                (label: "Jump to a unit still to act: {NextUnit}", done_when: Pressed("NextUnit")),
                (label: "See a unit's stats and weapons: {Info}", done_when: Pressed("Info")),
            ],
        ),
        (
            id: "moving",
            level: Full,
            trigger: FirstBattleStart,
            title: "Selecting a unit",
            text: "Pick up a unit and its reach lights up.\nSend it to a lit tile; its menu follows.",
            face: "neutral",
            items: [
                (label: "Select a unit: {Select}", done_when: UnitSelected),
                (label: "Send it to a lit tile: {Select}", done_when: UnitMoved),
                (label: "See its menu", done_when: ActionMenuOpened),
            ],
        ),
        (
            id: "attacking",
            level: Full,
            trigger: FirstEnemyInRange,
            title: "Attacking",
            text: "Point at an enemy in reach for the forecast.\nAttack if you like the odds, or back out.",
            face: "stern",
            items: [
                (label: "Open the forecast on an enemy", done_when: ForecastOpened),
                (label: "Attack: {Confirm}. Back out: {Cancel}", done_when: Attacked),
            ],
        ),
        (
            id: "ending_turn",
            level: Full,
            trigger: NoUnitLeft,
            title: "Ending the turn",
            text: "That's everyone. End the turn here, or from\nEnd turn in the map menu.",
            face: "neutral",
            items: [
                (label: "End turn: {EndTurn}, or menu: {Cancel}", done_when: TurnEnded),
            ],
        ),
        (
            id: "rewind",
            level: Short,
            trigger: SecondTurn,
            title: "Rewind",
            text: "Made a mess? Rewind undoes turns, for one of\na few charges per map. Just looking is free.",
            face: "sly",
            items: [
                (label: "Open Rewind: {Rewind}", done_when: RewindOpened),
                (label: "Close it without rewinding: {Cancel}", done_when: RewindClosed),
            ],
        ),
        (
            id: "threat_arrows",
            level: Short,
            trigger: ThreatArrowsShown,
            title: "Threat arrows",
            text: "Each arrow is an enemy that could hit your\nunit where it stands, or where it's headed.",
            face: "thinking",
            items: [
                (label: "Point a unit's path where arrows show", done_when: ThreatPointed),
                (label: "Point it at a tile with no arrows", done_when: SafePointed),
            ],
        ),
        (
            id: "combat_arts",
            level: Short,
            trigger: ArtsAvailable,
            title: "Combat Arts",
            text: "Arts are heavy hitters with their own menu.\nThey cost weapon wear, or uses per battle.",
            face: "sly",
            items: [
                (label: "Open Arts in the unit's menu", done_when: ArtsOpened),
            ],
        ),
        (
            id: "terrain_magic",
            level: Short,
            trigger: TileSpellAvailable,
            title: "Spells that change tiles",
            text: "Some spells remake a tile: fire burns forest.\nAim one at a tile and see what it turns into.",
            face: "thinking",
            items: [
                (label: "Aim a spell at a tile", done_when: TileAimed),
            ],
        ),
    ],
)
