// The public stand-in of the combat arts (ticket 0160, ADR-0117). The game's
// own file is in the private repository's content/, laid over this one by
// every build that has it checked out. A build without it (a fork) reads
// this: every art but the personal weapons'.
//
// Every Combat Art. Source: docs/design/combat-arts.md (0014), "Chapter 1
// arts": two per weapon kind, at ranks E and D (list approved by Nick).
// Every number is TUNABLE (FE-sized until ticket 0013). Ranks C-S (ticket
// 0018's list, "Ranks C-S" in the design doc) arrive in parts: the arts that
// change one combat's numbers or put a debuff on the target are here (0325);
// the stances that react are here too (0326); so are the arts that strike
// several units (0327); so are Disarm, Marked Shot and Unbroken Stride
// (0328); the special weapons' arts (0329) are at the end.
// Loaded by trpg_content::art; the rules are in trpg_core::art and
// trpg_core::battle.
//
// id: unique. kind: the weapon kind it is used with (Sword, Spear, Axe, Bow,
//   Gauntlet). rank: Some(E..S) teaches it at that weapon rank; None makes
//   it a weapon art, reached only through a weapon's `arts` list in
//   items.ron (usable by anyone wielding that weapon).
// cost: durability of the attacking weapon, paid once per combat (>= 1).
// effect, all optional (the whole combat, every strike of the attacker):
//   hit: n                       added to hit
//   sword_followup: (num, den)   sword follow-up ratio instead of 6/5
//                                (Sword arts only)
//   no_counter: true             the defender can't counter
//   effective: [(Tag, mult)]     added effectiveness; the largest matching
//                                multiplier wins
//   crit: n                      added to crit
//   axe_min_damage: n            axe minimum damage instead of 5 (Axe arts)
//   axe_min_damage_max_hp_div: n the axe minimum is at least a n-th of the
//                                target's max HP (Axe arts)
//   min_range: n, max_range: n   the weapon's range for this attack
//   cascade: n                   each hit deals n more than the hit before
//                                (Sword arts)
//   on_first_hit: [(stat: Def, amount: n), ...]
//                                the first hit lowers the target's stats by
//                                n (not below 0) until the end of its next
//                                phase (one `Some((stat: .., amount: ..))`
//                                still loads)
//   on_first_hit_avoid: n        and lowers its avoid by n (not below 0)
//   on_first_hit_status: [Disarmed | Marked(hit: n, crit: n), ...]
//                                and puts these on it until the end of its
//                                next phase. Disarmed: no more counters this
//                                combat, and no weapon attacks or counters;
//                                Marked: every strike at it gets +hit, +crit
//   on_kill: Some(ActAgain)      if the target falls to the user's strikes,
//                                the user may move and act again (once per
//                                phase)
//   stance: Some((stats: [...], combat: (avoid: n, ...)))
//                                on the user from this combat until the
//                                start of its next phase
//   line_pierce: true            after the combat, one strike at the unit
//                                directly behind the target
//   area: Some(Cleave | Line(n) | Burst)
//                                no combat: one strike, no counter, at each
//                                enemy of the area. Cleave: the adjacent
//                                target, then the tiles left and right of
//                                the user; Line(n): n tiles in the
//                                target's row or column, nearest first;
//                                Burst: the target, then the four tiles
//                                next to it, clockwise from the north
//   chain: true                  after the combat, each ally next to the
//                                target whose weapon reaches it strikes it
//                                once (no durability, no EXP for them)
//   pack_might: (per, max)       might +per for each other unit of the
//                                user's side next to the target, up to +max
//   power: Some(Str | Mag | Higher)
//                                the stat the attack's power uses (Higher:
//                                the larger of Str and Mag)
//   mitigation: Some(Def | Res)  the target's stat that mitigates it
// A stance may also have stops_enemies: true: a hostile unit stepping onto
//   a tile next to the user must stop there (Hold the Ford); and a
//   reaction (0326), one of:
//   reaction: Some(StrikesFirst) attacked, the user's first counter comes
//                                before the attacker's first strike
//   reaction: Some(Counters(reach: n, hit: h))
//                                attacked, the user counters at 1..n, its
//                                counters' hit +h
//   reaction: Some(Deflect)      the first strike at the user that would
//                                hit misses and the user strikes back; once
//   reaction: Some(Overwatch)    the art is an action of its own (no
//                                attack); the first hostile unit ending a
//                                move in the weapon's range is shot once
(
    arts: [
        (
            id: "flowing_cut", name: "Flowing Cut", kind: Sword, rank: Some(E), cost: 2,
            effect: (sword_followup: Some((3, 2))),
        ),
        (
            id: "guard_break", name: "Guard Break", kind: Sword, rank: Some(D), cost: 4,
            effect: (hit: 10, no_counter: true),
        ),
        (
            id: "cascade", name: "Cascade", kind: Sword, rank: Some(A), cost: 6,
            effect: (cascade: 3),
        ),
        (
            id: "disarm", name: "Disarm", kind: Sword, rank: Some(B), cost: 5,
            effect: (on_first_hit_status: [Disarmed]),
        ),
        (
            id: "unbroken_stride", name: "Unbroken Stride", kind: Sword, rank: Some(S), cost: 8,
            effect: (on_kill: Some(ActAgain)),
        ),
        (
            id: "riposte", name: "Riposte", kind: Sword, rank: Some(C), cost: 4,
            effect: (stance: Some((reaction: Some(StrikesFirst)))),
        ),
        (
            id: "unhorse", name: "Unhorse", kind: Spear, rank: Some(E), cost: 2,
            effect: (hit: 10, effective: [(Mounted, 3)]),
        ),
        (
            id: "long_thrust", name: "Long Thrust", kind: Spear, rank: Some(C), cost: 3,
            effect: (hit: -10, min_range: Some(1), max_range: Some(2)),
        ),
        (
            id: "skypiercer", name: "Skypiercer", kind: Spear, rank: Some(A), cost: 5,
            effect: (effective: [(Flying, 2)]),
        ),
        (
            id: "spear_wall", name: "Spear Wall", kind: Spear, rank: Some(B), cost: 4,
            effect: (stance: Some((reaction: Some(Counters(reach: 2, hit: 15))))),
        ),
        (
            id: "line_pierce", name: "Line Pierce", kind: Spear, rank: Some(D), cost: 4,
            effect: (line_pierce: true),
        ),
        (
            id: "comet_lance", name: "Comet Lance", kind: Spear, rank: Some(S), cost: 8,
            effect: (area: Some(Line(3)), min_range: Some(1), max_range: Some(3)),
        ),
        (
            id: "crushing_swing", name: "Crushing Swing", kind: Axe, rank: Some(E), cost: 2,
            effect: (hit: 20, axe_min_damage: Some(8)),
        ),
        (
            id: "armor_cleave", name: "Armor Cleave", kind: Axe, rank: Some(D), cost: 4,
            effect: (effective: [(Armored, 2)]),
        ),
        (
            id: "wide_swing", name: "Wide Swing", kind: Axe, rank: Some(C), cost: 4,
            effect: (area: Some(Cleave), min_range: Some(1), max_range: Some(1)),
        ),
        (
            id: "hurl", name: "Hurl", kind: Axe, rank: Some(B), cost: 4,
            effect: (hit: -10, min_range: Some(1), max_range: Some(2)),
        ),
        (
            id: "skull_splitter", name: "Skull Splitter", kind: Axe, rank: Some(A), cost: 5,
            effect: (crit: 30),
        ),
        (
            id: "felling_blow", name: "Felling Blow", kind: Axe, rank: Some(S), cost: 8,
            effect: (axe_min_damage_max_hp_div: Some(3)),
        ),
        (
            id: "close_shot", name: "Close Shot", kind: Bow, rank: Some(E), cost: 2,
            effect: (hit: -10, min_range: Some(1)),
        ),
        (
            id: "pinning_shot", name: "Pinning Shot", kind: Bow, rank: Some(D), cost: 3,
            effect: (on_first_hit: Some((stat: Mov, amount: 3))),
        ),
        (
            id: "rending_arrow", name: "Rending Arrow", kind: Bow, rank: Some(C), cost: 4,
            effect: (on_first_hit: [(stat: Def, amount: 5)]),
        ),
        (
            id: "overwatch", name: "Overwatch", kind: Bow, rank: Some(B), cost: 5,
            effect: (stance: Some((reaction: Some(Overwatch)))),
        ),
        (
            id: "marked_shot", name: "Marked Shot", kind: Bow, rank: Some(A), cost: 6,
            effect: (on_first_hit_status: [Marked(hit: 20, crit: 10)]),
        ),
        (
            id: "arrow_rain", name: "Arrow Rain", kind: Bow, rank: Some(S), cost: 8,
            effect: (area: Some(Burst), min_range: Some(2), max_range: Some(3)),
        ),
        (
            id: "pressure_point", name: "Pressure Point", kind: Gauntlet, rank: Some(E), cost: 2,
            effect: (on_first_hit: Some((stat: Spd, amount: 3))),
        ),
        (
            id: "off_balance", name: "Off Balance", kind: Gauntlet, rank: Some(C), cost: 3,
            effect: (on_first_hit_avoid: 20),
        ),
        (
            id: "deflect", name: "Deflect", kind: Gauntlet, rank: Some(B), cost: 5,
            effect: (stance: Some((reaction: Some(Deflect)))),
        ),
        (
            id: "sidestep", name: "Sidestep", kind: Gauntlet, rank: Some(D), cost: 3,
            effect: (stance: Some((combat: (avoid: 20)))),
        ),
        (
            id: "chain_strike", name: "Chain Strike", kind: Gauntlet, rank: Some(A), cost: 6,
            effect: (chain: true),
        ),
        (
            id: "vital_point", name: "Vital Point", kind: Gauntlet, rank: Some(S), cost: 8,
            effect: (on_first_hit: [
                (stat: Str, amount: 4), (stat: Mag, amount: 4), (stat: Def, amount: 4),
                (stat: Res, amount: 4), (stat: Spd, amount: 4),
            ]),
        ),
        (
            id: "pack_hunt", name: "Pack Hunt", kind: Axe, rank: None, cost: 3,
            effect: (pack_might: Some((2, 6))),
        ),
        (
            id: "hold_the_ford", name: "Hold the Ford", kind: Spear, rank: None, cost: 3,
            effect: (stance: Some((stops_enemies: true))),
        ),
        (
            id: "moonwave", name: "Moonwave", kind: Sword, rank: None, cost: 4,
            effect: (max_range: Some(2), power: Some(Higher), mitigation: Some(Res)),
        ),
    ],
)
