// reads this: the test chapter (assets-test/chapters/test.ron), which only a
// build with the test files has.
//
// Format: chapters/README.md.
(
    first_chapter: "test",
    roster: ["lead", "test_knight"],
    gold: 0,
    stock: [],
)
