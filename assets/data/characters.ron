// The Chapter 1 cast (ticket 0803; sheets in docs/story/characters/) and the
// Red Company's generic soldiers. Every stat, level and loadout is a
// *tunable* starting value, judged in the Chapter 1 playtest (0804). Loaded
// by trpg_content::character. The test characters and templates (ids
// starting `test_`) are in assets-test/data/characters.ron (ADR-0057).
//
// characters: named characters.
//   id: also the character's name id: the display name is its entry in
//     names.ron (ticket 0709), never written here.
//   base is in stat order (HP, Str, Mag, Dex, Spd, Def, Res) (Mov comes from
//   the class) and must be <= the hard ceilings (classes.ron).
//   talent: the +20% growth stat (not Mov).
//   weapon_ranks: (kind, rank); raised to the class's start ranks on entry.
//   personal_spells: (character level, spell id), at most 2; none for the lord.
//   is_lord: only the lord may start in a lord-only class.
//   map_label (optional, characters and generics): Some("Xy"), the two letters drawn on
//     the map, instead of the first two letters of the name (generics: of
//     the class name). Named units of one side on a map need distinct labels.
//   loadout (optional, characters and generics): (weapons: [ids], armour:
//     Some(id), accessory: Some(id)), items from items.ron; at most the
//     class's weapon slots, armour of a weight the class wears. The first
//     weapon the unit can wield starts equipped.
// generics: generic unit templates (class + character level); their stats
//   come from the class (progression.md, "Generic units").
// speakers: ids of people who talk in dialogue (.dlg) but aren't units: no
//   class, stats or loadout, only a name, which is the id's entry in
//   names.ron. A speaker can't be put on a battle's map or named in a
//   battle or chapter file; for that they need an entry in characters (and
//   then come out of speakers: a character can already speak). A
//   conversation's opening (assets/openings/) may place one on a place: a
//   picture, not a unit.
(
    characters: [
        // The lead (ticket 0708): the player picks the gender and first
        // name at New Game, so dialogue shows the chosen name and the
        // portrait lead_m or lead_f. The Exile's own base, with a point
        // of the talent stat.
        (
            id: "lead", class: "exile", level: 1, is_lord: true,
            map_label: Some("El"),
            talent: Str,
            base: (19, 7, 1, 7, 7, 4, 3),
            weapon_ranks: [(Sword, D)],
            loadout: (weapons: ["iron_sword", "steel_sword"], armour: Some("leather_vest")),
        ),
        // Hollis Marr: twenty years a guard captain, so two levels up on
        // the others.
        (
            id: "retainer", class: "guard", level: 3,
            talent: Hp,
            base: (24, 8, 0, 5, 3, 10, 1),
            weapon_ranks: [(Spear, D)],
            loadout: (weapons: ["iron_spear", "steel_spear"], armour: Some("chain_mail")),
        ),
        // Tamsin Rook: a cavalry sergeant of the Red Company until last
        // winter.
        (
            id: "sergeant", class: "rider", level: 2,
            talent: Spd,
            base: (21, 7, 0, 6, 5, 5, 1),
            weapon_ranks: [(Sword, E), (Spear, D)],
            loadout: (weapons: ["iron_spear"], armour: Some("leather_vest")),
        ),
        // Aske.
        (
            id: "poacher", class: "archer", level: 1,
            talent: Dex,
            base: (17, 5, 0, 8, 6, 3, 1),
            weapon_ranks: [(Bow, D)],
            loadout: (weapons: ["iron_bow"], armour: Some("leather_vest")),
        ),
        // Maud: Heal from the class, and her own vow, Vigil Light
        // (keeper.md).
        (
            id: "keeper", class: "cleric", level: 1,
            talent: Res,
            base: (17, 1, 6, 4, 5, 1, 8),
            weapon_ranks: [(Gauntlet, E)],
            personal_spells: [(1, "vigil_light")],
            loadout: (weapons: ["iron_gauntlets"], armour: Some("linen_robe")),
        ),
        // Rue: Fire from the class, and the vow she swore at the
        // Ashfields, Cinder Oath (heretic.md). No sword: she fights with
        // her vows.
        (
            id: "heretic", class: "mage", level: 1,
            talent: Mag,
            base: (16, 1, 7, 5, 6, 1, 5),
            weapon_ranks: [],
            personal_spells: [(1, "cinder_oath")],
            loadout: (armour: Some("linen_robe")),
        ),
        // Red Harl Coster, the Chapter 1 boss (red_captain.md).
        (
            id: "red_captain", class: "brigand", level: 5,
            talent: Str,
            base: (30, 10, 0, 6, 6, 6, 1),
            weapon_ranks: [(Axe, D)],
            loadout: (weapons: ["steel_axe", "iron_axe"], armour: Some("leather_vest")),
        ),
    ],
    generics: [
        // The Red Company (Chapter 1's enemies).
        (id: "red_brigand", class: "brigand", level: 1, loadout: (weapons: ["iron_axe"])),
        (id: "red_raider", class: "raider", level: 1, loadout: (weapons: ["iron_axe"])),
        (id: "red_archer", class: "archer", level: 1, loadout: (weapons: ["iron_bow"])),
        (id: "red_rider", class: "rider", level: 1, loadout: (weapons: ["iron_spear"])),
        (
            id: "red_guard", class: "guard", level: 1,
            loadout: (weapons: ["iron_spear"], armour: Some("chain_mail")),
        ),
    ],
    // speakers: ids that may speak in dialogue (.dlg) but aren't units
    // (yet). Each needs a name in names.ron. The rival and the Master of
    // Vows don't fight in Chapter 1; the messenger (ticket 0707) only
    // ever speaks.
    // Chapter 2 (ticket 0744): Joss, the Hound lieutenant and the Hound
    // sergeant speak before they are units; 0848 and 0849 move them into
    // characters when they build the battles. The herald only ever speaks.
    // Chapter 3 (ticket 0745): the prior of Greywater speaks before 0849
    // makes him a unit.
    speakers: ["rival", "vowmaster", "messenger", "defector", "hound_lieutenant", "hound_sergeant", "herald", "greywater_prior", "prizefighter"],
)
