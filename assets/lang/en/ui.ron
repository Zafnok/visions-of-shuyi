// English screen text, by key (ADR-0045). Screens ask for it with
// `ctx.text("title.new_game")`. Keys are `screen.thing`: lowercase letters,
// digits, `_` and `.`.
//
// `{Confirm}`, `{Cancel}`, `{Cursor}` and the other action names become
// the player's keys (never write a key's name here); any other `{name}` is
// a value the screen fills in.
{
    // The title screen.
    "title.title": "Visions of Shuyi",
    "title.subtitle": "an ASCII tactics game",
    "title.press_any_key": "Press any key or button",
    "title.continue": "Continue",
    "title.new_game": "New Game",
    "title.load_game": "Load Game",
    "title.quick_battle": "Quick Battle",
    "title.options": "Options",
    "title.credits": "Credits",
    "title.quit": "Quit",
    "title.help": "{Cursor} move · {Confirm} select · {Cancel} back",

    // The layout picker, on first launch and opened from Options. In
    // `help_first`, `{up}`, `{down}` and `{confirm}` are every key of each.
    "layout_picker.title": "Pick your layout",
    "layout_picker.right_handed": "Right-handed",
    "layout_picker.left_handed": "Left-handed",
    "layout_picker.legend.move": "move",
    "layout_picker.legend.select": "select",
    "layout_picker.legend.back": "back",
    "layout_picker.legend.prev_unit": "prev unit",
    "layout_picker.legend.next_unit": "next unit",
    "layout_picker.legend.unit_info": "unit info",
    "layout_picker.legend.danger_zone": "danger zone",
    "layout_picker.legend.end_turn": "end turn",
    "layout_picker.legend.auto_end": "auto-end",
    "layout_picker.legend.rewind": "rewind",
    "layout_picker.help_first": "{up} {down} choose · {confirm} pick",
    "layout_picker.help_change": "{CursorUp} {CursorDown} choose · {Confirm} pick · {Cancel} back",

    // The game mode screen, after New Game.
    "mode_select.heading": "Choose a game mode",
    "mode_select.classic": "Classic",
    "mode_select.classic_line": "Classic: a unit that falls in battle dies and is gone for good.",
    "mode_select.casual": "Casual",
    "mode_select.casual_line": "Casual: a unit that falls retreats, and is back for the next battle.",
    "mode_select.help": "{Cursor} choose · {Confirm} select · {Cancel} back",

    // The lead screen: the lead's gender and first name.
    "lead_select.heading": "Choose your lead",
    "lead_select.male": "Male",
    "lead_select.female": "Female",
    "lead_select.name": "Name",
    "lead_select.start": "Start",
    "lead_select.first_name": "First name",
    "lead_select.type_hint": "Type a name on your keyboard.",
    "lead_select.grid.blank": "Blank",
    "lead_select.grid.delete": "Delete",
    "lead_select.grid.done": "Done",
    "lead_select.help.gender": "{Cursor} choose · {Confirm} next · {Cancel} back",
    "lead_select.help.name": "{Cursor} choose · {Confirm} change name · {Cancel} back",
    "lead_select.help.start": "{Cursor} choose · {Confirm} start · {Cancel} back",
    "lead_select.help.grid": "{Cursor} choose · {Confirm} type · {Cancel} delete",

    // A box the player types in (the lead's name, a volume). `{done}`,
    // `{delete}` and `{cancel}` are its own keys.
    "text_box.help": "{done} done · {delete} delete · {cancel} cancel",

    // A dialogue scene.
    "dialogue.skip_question": "Skip scene?",
    "dialogue.skip_answers": "{Confirm} yes / {Cancel} no",

    // The results after a won battle.
    "results.heading": "VICTORY",
    "results.gold": "Gold for clearing the map",
