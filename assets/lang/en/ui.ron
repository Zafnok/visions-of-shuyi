// English screen text, by key (ADR-0045). Screens ask for it with
// `ctx.text("title.new_game")`. Keys are `screen.thing`: lowercase letters,
// digits, `_` and `.`.
//
// `{Confirm}`, `{Cancel}`, `{Cursor}` and the other action names become
// the player's keys (never write a key's name here); any other `{name}` is
// a value the screen fills in.
{
    // The title screen.
    "title.press_any_key": "Press any key or button",
    "title.continue": "Continue",
    "title.new_game": "New Game",
    "title.load_game": "Load Game",
    "title.quick_battle": "Quick Battle",
    "title.options": "Options",
    "title.profile": "Profile",
    "title.credits": "Credits",
    "title.quit": "Quit",
    "title.help": "{Cursor} move · {Confirm} select · {Cancel} back",

    // Player profiles (`docs/design/options.md`). `{n}` is the profile's
    // number: the first profile, made on a first launch, is `Player 1`.
    "profile.numbered": "Player {n}",
    // The Profile screen, from the title. `{name}` is a profile's name;
    // `{n}` the most profiles there can be.
    "profile.title": "Profile",
    "profile.current": "in use",
    "profile.add": "Add a profile",
    "profile.name_box": "Profile name",
    "profile.action.switch": "Use this profile",
    "profile.action.rename": "Rename",
    "profile.action.delete": "Delete",
    "profile.question.delete": "Delete {name}? Its options and saves go with it.",
    "profile.answer.yes": "Yes",
    "profile.answer.no": "No",
    "profile.question.keep": "Keep this name?",
    "profile.message.name_taken": "Another profile already has that name.",
    "profile.message.too_many": "There can be at most {n} profiles.",
    "profile.message.not_saved": "The profiles couldn't be saved.",
    "profile.help.list": "{Cursor} move · {Confirm} choose · {Cancel} back",
    "profile.help.add": "{Cursor} move · {Confirm} add · {Cancel} back",
    "profile.help.none": "{Cursor} move · {Cancel} back",
    "profile.help.actions": "{Cursor} move · {Confirm} select · {Cancel} back",
    "profile.help.question": "{Cursor} choose · {Confirm} pick · {Cancel} back",

    // The layout picker, on first launch and opened from Options. In
    // `help_first`, `{up}`, `{down}` and `{confirm}` are every key of each.
    "layout_picker.title": "Pick your layout",
    "layout_picker.right_handed": "Right-handed",
    "layout_picker.left_handed": "Left-handed",
    "layout_picker.legend.move": "move",
    "layout_picker.legend.select": "select",
