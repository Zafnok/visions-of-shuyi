// Chapter 3's battle (ticket 0849; beat sheet assets-private/story/chapters/ch03.md):
// seize the scriptorium of Greywater Abbey. Only the lead may seize
// (Fire Emblem's Seize, terrain.md), on the prior's seat at the long
// room's west end, and the prior sits on it: he has to be beaten first.
// No turn limit. Every number here is a *Claude's starting value*, set by
// the bots (`cargo shuyi autobalance --stage ch03`) and judged in the Act 1
// playtest (1064).
//
// The approach: the party comes in on the shore and goes out along the
// causeway. Two Hounds hold the landing halfway; Ned Tolley and a warden
// hold the gate, an archer in each tower beside it. A wader can go round
// by the shallows under the south tower to the breach. Inside, the
// courtyard's wardens and Hounds, then the scriptorium's stair, two more
// at the top and the prior at his hearth. The reliquary's three chests
// are a detour east across the courtyard, past one warden.
(
    id: "ch03",
    map: "ch03",
    // The shore, at the causeway's foot.
    player_slots: [
        (character: "lead", pos: (3, 8)),
        (character: "retainer", pos: (3, 7)),
        (character: "sergeant", pos: (2, 8)),
        (character: "poacher", pos: (2, 6)),
        (character: "keeper", pos: (1, 8)),
        (character: "heretic", pos: (2, 7)),
        (character: "defector", pos: (1, 7)),
    ],
    enemies: [
        // The landing halfway along the causeway.
        (template: "hound_raider", pos: (10, 6), ai: Guard, level: Some(6)),
        (template: "hound_swordsman", pos: (10, 9), ai: Guard, level: Some(6)),
        // The gate, and an archer in each tower beside it.
        (character: "hound_sergeant", pos: (15, 7), ai: Guard),
        (template: "warden_guard", pos: (15, 8), ai: Guard, level: Some(6)),
        (template: "hound_archer", pos: (15, 6), ai: Stationary, level: Some(6)),
        (template: "hound_archer", pos: (15, 9), ai: Stationary, level: Some(6)),
        // The courtyard.
        (template: "warden_guard", pos: (18, 7), ai: Guard, level: Some(6)),
        (template: "hound_raider", pos: (20, 9), ai: Guard, level: Some(6)),
        (template: "hound_rider", pos: (24, 7), ai: Guard, level: Some(6)),
        (template: "warden_archer", pos: (22, 12), ai: Guard, level: Some(6)),
        // The scriptorium: the prior at his seat, two at the top of the stair.
        (character: "greywater_prior", pos: (16, 3), ai: Stationary, boss: true),
        (template: "hound_swordsman", pos: (17, 3), ai: Guard, level: Some(6)),
        (template: "warden_guard", pos: (18, 4), ai: Guard, level: Some(6)),
        // The reliquary.
        (template: "warden_archer", pos: (25, 3), ai: Guard, level: Some(6)),
    ],
    preparations: true,
    // A short pack, after Chapter 2's 4: with 4 the bots' Normal player
    // drank them all and won (playtesting.md); with 3 it wins on 3.
    pack_cap: 3,
    // The debug Quick Battle: about what Chapter 2
    // leaves (Chapter 1's Potions, its two rewards and Hendry's axe in the
    // stock, its gold and Chapter 1's).
    solo_stock: ["potion", "potion", "potion", "houndmasters_axe", "fordwardens_spear", "elixir"],
    solo_gold: 2200,
    clear_gold: 1500,
    objective: Seize(pos: (16, 3), by_lord: true),
    // Scene ids and what each is written for: the top of dialogue/ch03.dlg.
    triggers: [
        (when: TurnStart(turn: 1, phase: Player), scene: "ch03_first_turn", once: true),
        (
            when: CombatStart(unit: "hound_sergeant", against: Some("retainer")),
            scene: "ch03_sergeant_engage_retainer",
            once: true,
        ),
        (when: CombatStart(unit: "hound_sergeant"), scene: "ch03_sergeant_engage", once: true),
        (when: UnitFell(unit: "hound_sergeant"), scene: "ch03_death_hound_sergeant", once: true),
        (
            when: CombatStart(unit: "greywater_prior", against: Some("keeper")),
            scene: "ch03_boss_engage_keeper",
            once: true,
        ),
        (when: CombatStart(unit: "greywater_prior"), scene: "ch03_boss_engage", once: true),
        (when: HalfHp(unit: "greywater_prior"), scene: "ch03_boss_half", once: true),
        (when: UnitFell(unit: "greywater_prior"), scene: "ch03_death_greywater_prior", once: true),
        // Anyone of the party coming up the stair into the long room.
        (
            when: UnitEntersArea(who: Faction(Player), area: (x: 16, y: 2, w: 6, h: 3)),
            scene: "ch03_scriptorium",
            once: true,
        ),
        (when: UnitFell(unit: "lead"), scene: "ch03_death_lead", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Classic)), scene: "ch03_death_retainer", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Casual)), scene: "ch03_retreat_retainer", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Classic)), scene: "ch03_death_sergeant", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Casual)), scene: "ch03_retreat_sergeant", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Classic)), scene: "ch03_death_poacher", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Casual)), scene: "ch03_retreat_poacher", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Classic)), scene: "ch03_death_keeper", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Casual)), scene: "ch03_retreat_keeper", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Classic)), scene: "ch03_death_heretic", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Casual)), scene: "ch03_retreat_heretic", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Classic)), scene: "ch03_death_defector", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Casual)), scene: "ch03_retreat_defector", once: true),
    ],
    // The first Seize: who may take it, and where.
    battle_notes: [
        (text: "Only the exile can seize the prior's seat, and he sits on it.", units: ["lead", "greywater_prior"]),
    ],
    difficulty: Normal,
    music: Cue("battle_church_2"),
    seed: 849,
)
