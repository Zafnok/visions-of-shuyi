// Chapter 4's battle (ticket 0850; beat sheet docs/story/chapters/ch04.md):
// Veyne Hall, the lead's childhood home. Defeat Dace: at 0 HP he retreats
// by the laundry door instead of falling (turn-structure.md, *A boss who
// retreats*), which wins the battle, and the Hounds still on the map run
// (`leftovers: Flee`). No turn limit. Every number here is a *Claude's
// starting value*, set by the bots (`cargo shuyi autobalance --stage
// ch04`) and judged in the Act 1 playtest (1064).
//
// The approach: the party stands on the road south of the gate Dace shut.
// The gate is held, a Hound archer in each of the guardroom's forts behind
// it; the yard beyond has three more and one on the hall's front door. The
// other way is Hollis's: east along the wall, up the river meadow past
// the sentries on the long wall, in by the laundry door, up the servants'
// passage to the kitchen and the stair into the hall. Dace holds the
// lord's end of the hall with two of his Hounds; he comes at whoever
// reaches him there (`Guard`). On turn 7 three of his riders come back up
// the road behind the party.
//
// Reached from the world map (worldmaps/act1.ron, `veyne_hall`).
(
    id: "ch04",
    map: "ch04",
    // The road south of the gate. Gil's slot stays empty unless he was
    // beaten on Millhaven Road (1071).
    player_slots: [
        (character: "lead", pos: (13, 14)),
        (character: "retainer", pos: (12, 14)),
        (character: "sergeant", pos: (14, 15)),
        (character: "poacher", pos: (11, 15)),
        (character: "keeper", pos: (12, 15)),
        (character: "heretic", pos: (13, 15)),
        (character: "defector", pos: (14, 14)),
        (character: "prizefighter", pos: (15, 14)),
    ],
    enemies: [
        // The gate, and an archer in each fort of the guardroom.
        (template: "hound_guard", pos: (13, 12), ai: Guard, level: Some(9)),
        (template: "hound_archer", pos: (12, 11), ai: Stationary, level: Some(9)),
        (template: "hound_archer", pos: (14, 11), ai: Stationary, level: Some(9)),
        // The yard, and the hall's front door.
        (template: "hound_raider", pos: (9, 8), ai: Guard, level: Some(9)),
        (template: "hound_swordsman", pos: (16, 8), ai: Guard, level: Some(9)),
        (template: "hound_rider", pos: (11, 6), ai: Guard, level: Some(9)),
        (template: "hound_guard", pos: (13, 6), ai: Guard, level: Some(9)),
        // The sentries outside the long wall, in the river meadow.
        (template: "hound_swordsman", pos: (23, 8), ai: Guard, level: Some(9)),
        (template: "hound_archer", pos: (24, 12), ai: Guard, level: Some(9)),
        // The kitchen.
        (template: "hound_raider", pos: (18, 3), ai: Guard, level: Some(9)),
        // The hall: Dace at the lord's end, two of his Hounds.
        (character: "rival", pos: (5, 3), ai: Guard, boss: true, defeat: Retreats),
        (template: "hound_guard", pos: (7, 3), ai: Guard, level: Some(9)),
        (template: "hound_archer", pos: (9, 2), ai: Guard, level: Some(9)),
    ],
    reinforcements: [
        // His riders, back up the road behind the party: a fight that drags
        // meets them (playtesting.md, Chapter 4).
        (turn: 7, unit: (template: "hound_rider", pos: (12, 15), level: Some(9))),
        (turn: 7, unit: (template: "hound_rider", pos: (13, 15), level: Some(9))),
        (turn: 7, unit: (template: "hound_rider", pos: (14, 15), level: Some(9))),
    ],
    preparations: true,
    pack_cap: 3,
    // The debug Quick Battle: about what Chapter 3 leaves (its chests'
    // Elixir and the stock before it, its gold and the chapters' before).
    solo_stock: ["potion", "potion", "potion", "houndmasters_axe", "fordwardens_spear", "elixir", "elixir", "focus_charm"],
    solo_gold: 3700,
    clear_gold: 1800,
    objective: DefeatUnit(unit: "rival", leftovers: Flee),
    // Scene ids and what each is written for: the top of dialogue/ch04.dlg.
    triggers: [
        (when: TurnStart(turn: 1, phase: Player), scene: "ch04_first_turn", once: true),
        // Anyone of the party in the servants' passage.
        (
            when: UnitEntersArea(who: Faction(Player), area: (x: 20, y: 5, w: 1, h: 6)),
            scene: "ch04_passage",
            once: true,
        ),
        (when: CombatStart(unit: "rival", against: Some("lead")), scene: "ch04_boss_engage_lead", once: true),
        (
            when: CombatStart(unit: "rival", against: Some("retainer")),
            scene: "ch04_boss_engage_retainer",
            once: true,
        ),
        (
            when: CombatStart(unit: "rival", against: Some("heretic")),
            scene: "ch04_boss_engage_heretic",
            once: true,
        ),
        (
            when: CombatStart(unit: "rival", against: Some("defector")),
            scene: "ch04_boss_engage_defector",
            once: true,
        ),
        (when: CombatStart(unit: "rival"), scene: "ch04_boss_engage", once: true),
        (when: HalfHp(unit: "rival"), scene: "ch04_boss_half", once: true),
        (when: UnitFell(unit: "rival"), scene: "ch04_boss_retreat", once: true),
        (when: UnitFell(unit: "lead"), scene: "ch04_death_lead", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Classic)), scene: "ch04_death_retainer", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Casual)), scene: "ch04_retreat_retainer", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Classic)), scene: "ch04_death_sergeant", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Casual)), scene: "ch04_retreat_sergeant", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Classic)), scene: "ch04_death_poacher", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Casual)), scene: "ch04_retreat_poacher", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Classic)), scene: "ch04_death_keeper", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Casual)), scene: "ch04_retreat_keeper", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Classic)), scene: "ch04_death_heretic", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Casual)), scene: "ch04_retreat_heretic", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Classic)), scene: "ch04_death_defector", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Casual)), scene: "ch04_retreat_defector", once: true),
        (
            when: UnitFell(unit: "prizefighter", mode: Some(Classic)),
            scene: "ch04_death_prizefighter",
            once: true,
        ),
        (
            when: UnitFell(unit: "prizefighter", mode: Some(Casual)),
            scene: "ch04_retreat_prizefighter",
            once: true,
        ),
    ],
    // The first boss who retreats in the story (the paymaster's side quest
    // may come first): beating him wins, and the hall's two ways in.
    battle_notes: [
        (text: "Dace runs when he is beaten. That wins the hall, and his Hounds run with him.", units: ["rival"]),
        (text: "Hollis's way in: the laundry door in the long wall, east, and the passage up.", units: ["retainer"]),
    ],
    difficulty: Normal,
    music: Cue("battle_rival"),
    seed: 850,
)
