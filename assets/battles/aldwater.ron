// Aldwater Toll Bridge (ticket 1071; ch04.dlg, ch04_aldwater_intro and
// _victory): a fixed skirmish of Chapter 4 that guards the road to Veyne
// Hall, so every player wins it on the way (world-structure.md). Rout the
// Hound post: one at the bar on the bridge, two on the near bank who
// spread out across the road, two archers and a rider on the far bank.
// The river is waded on foot, never on a horse. The toll-chest under the
// bar is the clear gold (the scene hands half of it back to the carters).
//
// Reached from the world map (worldmaps/act1.ron, `aldwater`). Every
// number here is *the agent's starting value*, set by the bots (`cargo
// shuyi autobalance --stage aldwater`) and judged in the Act 1 playtest
// (1064). The army is the one Chapters 1 to 3 leave, so no `bots_army`:
// the bots' arrival army and the chapter tests fight here before Veyne
// Hall (1071).
(
    id: "aldwater",
    map: "aldwater",
    // The road on the near bank.
    player_slots: [
        (character: "lead", pos: (2, 5)),
        (character: "retainer", pos: (3, 5)),
        (character: "sergeant", pos: (1, 5)),
        (character: "poacher", pos: (2, 4)),
        (character: "keeper", pos: (1, 4)),
        (character: "heretic", pos: (2, 6)),
        (character: "defector", pos: (3, 6)),
        (character: "prizefighter", pos: (3, 4)),
    ],
    enemies: [
        // The bar, on the bridge.
        (template: "hound_guard", pos: (9, 5), ai: Guard, level: Some(9)),
        // The near bank, spread across the road.
        (template: "hound_swordsman", pos: (6, 4), level: Some(11)),
        (template: "hound_raider", pos: (6, 6), level: Some(9)),
        // The far bank.
        (template: "hound_archer", pos: (11, 3), ai: Guard, level: Some(9)),
        (template: "hound_archer", pos: (11, 7), ai: Guard, level: Some(9)),
        (template: "hound_rider", pos: (13, 5), ai: Guard, level: Some(9)),
    ],
    preparations: true,
    pack_cap: 3,
    clear_gold: 400,
    objective: Rout(),
    difficulty: Easy,
    kind: FixedSkirmish,
    music: Pool("skirmish"),
    seed: 1071,
)
