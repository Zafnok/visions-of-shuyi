// Smugglers' Cove (ticket 1071; ch05.dlg, ch05_cove_intro and
// _victory): an optional fixed skirmish of Chapter 5, "with loot"
// (outline.md). Rout the smugglers on the beach under the cliffs; the
// party comes down by the track or Aske's path through the gorse. The
// smugglers are the privateers' templates: sailors who are nobody's
// soldiers. The casks they leave are the loot, in `clear_gold` and
// `clear_items`.
//
// Reached from the world map (worldmaps/act1.ron, `smugglers_cove`): it
// opens with Saltmere once the Salt Road is won, and may be fought before
// or after the Envoy's House. Every number here is *the agent's starting
// value*, set by the bots (`cargo shuyi autobalance --stage
// smugglers_cove`) and judged in the Act 1 playtest (1064).
(
    id: "smugglers_cove",
    map: "smugglers_cove",
    // The cliff top.
    player_slots: [
        (character: "lead", pos: (7, 1)),
        (character: "retainer", pos: (8, 1)),
        (character: "sergeant", pos: (6, 0)),
        (character: "poacher", pos: (3, 1)),
        (character: "keeper", pos: (5, 1)),
        (character: "heretic", pos: (4, 1)),
        (character: "defector", pos: (9, 0)),
        (character: "prizefighter", pos: (10, 1)),
        (character: "shieldbearer", pos: (11, 1)),
    ],
    enemies: [
        // The foot of the track.
        (template: "privateer_cutlass", pos: (9, 5), ai: Guard, level: Some(13)),
        (template: "privateer_bowman", pos: (11, 6), ai: Guard, level: Some(13)),
        // The beach and the huts.
        (template: "privateer_axe", pos: (5, 6), level: Some(12)),
        (template: "privateer_brawler", pos: (7, 7), level: Some(12)),
        (template: "privateer_bowman", pos: (2, 8), ai: Guard, level: Some(12)),
        (template: "privateer_cutlass", pos: (10, 8), level: Some(12)),
        // By the boats.
        (template: "privateer_axe", pos: (13, 9), ai: Guard, level: Some(12)),
    ],
    preparations: true,
    pack_cap: 3,
    bots_army: (chapter: "ch05", level: 8),
    clear_gold: 800,
    clear_items: ["elixir", "potion", "potion"],
    objective: Rout(),
    difficulty: Normal,
    kind: FixedSkirmish,
    music: Pool("skirmish"),
    seed: 1074,
)
