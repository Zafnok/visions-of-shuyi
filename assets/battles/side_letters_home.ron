// Letters Home, Aske's side quest (ticket 1072; beat sheet
// docs/story/chapters/side-aske.md): Gull Creek, east of Saltmere, where
// League privateers hold the hill people's boat with its letters and
// silver, and its people nailed into the hold. Defeat Jory Casker, the
// privateer captain, and his crew run for their sloop (`leftovers: Flee`).
// Every number here is a *Claude's starting value*, set by the bots
// (`cargo shuyi autobalance --stage side_letters_home`) and judged in the
// Act 1 playtest (1064).
//
// The fight as authored: the party comes down the cliff path at the top
// left, the lead last, onto open shingle. Three privateers hold the foot
// of the path, a bowman stands on the rock in the middle, and the rest hold the camp
// and the boat: a brawler at the gangplank's foot, a cutlass on the
// plank's deck end, two bowmen on the deck covering it, and Casker on
// the deck by the nailed hatch. The creek can be waded on foot, slowly,
// so the boat can be reached from the water as well as the plank. On
// turn 3 two more come up the beach from the sloop's boat.
//
// Reached from the world map (worldmaps/act1.ron, `letters_home`): it
// opens once the Envoy's House is held while Aske is in the army, and may
// be fought any time to the end of Act 1. The reward is the quest's
// unique one (world-structure.md, 0069; combat-arts.md, *Special
// weapons*): Tor's Bow, Aske's personal weapon, in `clear_items`.
(
    id: "side_letters_home",
    map: "side_letters_home",
    // The top of the cliff path. Gil (1071) and Hedda (0851) get slots
    // here when they are units.
    player_slots: [
        (character: "lead", pos: (3, 0)),
        (character: "retainer", pos: (3, 1)),
        (character: "sergeant", pos: (2, 1)),
        (character: "poacher", pos: (2, 2)),
        (character: "keeper", pos: (1, 2)),
        (character: "heretic", pos: (3, 2)),
        (character: "defector", pos: (4, 1)),
    ],
    enemies: [
        // The foot of the cliff path.
        (template: "privateer_cutlass", pos: (5, 4), ai: Guard, level: Some(11)),
        (template: "privateer_axe", pos: (7, 6), ai: Guard, level: Some(9)),
        (template: "privateer_brawler", pos: (4, 7), ai: Guard, level: Some(10)),
        // On the rock.
        (template: "privateer_bowman", pos: (10, 6), ai: Guard, level: Some(10)),
        // The gangplank and the deck: Casker on the deck by the hatch.
        (template: "privateer_brawler", pos: (13, 6), ai: Guard, level: Some(11)),
        (template: "privateer_bowman", pos: (16, 7), ai: Guard, level: Some(14), id: "deck_bow_1"),
        (template: "privateer_bowman", pos: (18, 7), ai: Guard, level: Some(14), id: "deck_bow_2"),
        (character: "privateer", pos: (16, 8), ai: Stationary, boss: true),
        // The camp.
        (template: "privateer_cutlass", pos: (12, 9), ai: Guard, level: Some(10)),
        (template: "privateer_bowman", pos: (9, 10), ai: Guard, level: Some(10)),
        (template: "privateer_axe", pos: (11, 11), ai: Guard, level: Some(10)),
    ],
    // From the sloop's boat, up the beach.
    reinforcements: [
        (turn: 3, unit: (template: "privateer_cutlass", pos: (12, 12), level: Some(14))),
        (turn: 3, unit: (template: "privateer_axe", pos: (13, 11), level: Some(14))),
    ],
    preparations: true,
    pack_cap: 4,
    // The debug Quick Battle: a Chapter 5 purse and some Potions.
    solo_stock: ["potion", "potion", "potion", "hi_potion"],
    solo_gold: 2000,
    // The bots' army: who the player has after Saltmere (Hedda lent), at
    // the level a player reaches the creek with.
    bots_army: (chapter: "ch06", level: 12),
    // The privateers' purse, and the quest's reward: Tor's Bow.
    clear_gold: 400,
    clear_items: ["tors_bow"],
    objective: DefeatUnit(unit: "privateer", leftovers: Flee),
    // Scene ids and what each is written for: the top of dialogue/side_letters.dlg.
    triggers: [
        (when: TurnStart(turn: 1, phase: Player), scene: "side_letters_first_turn", once: true),
        (
            when: UnitEntersArea(who: Faction(Player), area: (x: 15, y: 6, w: 4, h: 3)),
            scene: "side_letters_boat",
            once: true,
        ),
        (
            when: CombatStart(unit: "privateer", against: Some("poacher")),
            scene: "side_letters_boss_engage_poacher",
            once: true,
        ),
        (when: CombatStart(unit: "privateer"), scene: "side_letters_boss_engage", once: true),
        (when: HalfHp(unit: "privateer"), scene: "side_letters_boss_half", once: true),
        (when: UnitFell(unit: "privateer"), scene: "side_letters_boss_fell", once: true),
        (when: UnitFell(unit: "lead"), scene: "side_letters_death_lead", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Classic)), scene: "side_letters_death_retainer", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Casual)), scene: "side_letters_retreat_retainer", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Classic)), scene: "side_letters_death_sergeant", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Casual)), scene: "side_letters_retreat_sergeant", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Classic)), scene: "side_letters_death_poacher", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Casual)), scene: "side_letters_retreat_poacher", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Classic)), scene: "side_letters_death_keeper", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Casual)), scene: "side_letters_retreat_keeper", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Classic)), scene: "side_letters_death_heretic", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Casual)), scene: "side_letters_retreat_heretic", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Classic)), scene: "side_letters_death_defector", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Casual)), scene: "side_letters_retreat_defector", once: true),
    ],
    battle_notes: [
        (text: "Casker holds the boat's deck. Beat him and his crew run for the sloop.", units: ["privateer"]),
        (text: "The bowmen on the deck cover the gangplank. The creek can be waded on foot, slowly.", units: ["deck_bow_1", "deck_bow_2"]),
    ],
    difficulty: Normal,
    kind: SideQuest,
    music: Cue("side_quest"),
    seed: 1073,
)
