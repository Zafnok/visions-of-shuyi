// The Company Ledger, Tamsin's side quest (ticket 1072; beat sheet
// assets-private/story/chapters/side-tamsin.md): the crown's tithe barn at
// Kingsmead, where the southern counties' pay is counted. Defeat Ambrose
// Tull, the paymaster: at 0 HP he retreats out the back with the purse he
// counted (turn-structure.md, *A boss who retreats*), which wins, and the
// men he pays run (`leftovers: Flee`). Every number here is a *Claude's
// starting value*, set by the bots (`cargo shuyi autobalance --stage
// side_company_ledger`) and judged in the Act 1 playtest (1064).
//
// The fight as authored: Hounds hold the yard gate (a guard on it, two
// archers behind the wall) and a swordsman and a rider meet the party on
// the lane; the wall's ends are open fields, with two of the Unpaid on the
// west flank. In the yard, Red Company men on the paymaster's shilling;
// Denny Rudd holds the barn step and comes no further. Inside, a guard and
// an archer, and Tull in the strongroom with one guard. On turn 4 two
// Hound riders come up the Millhaven road from the east. A horse can't
// wade the stream, so Tamsin's way in is the bridge or the ford at the
// wall's ends.
//
// Reached from the world map (worldmaps/act1.ron, `company_ledger`): it
// opens once Aldwater Toll Bridge is won while Tamsin is in the army, and
// may be fought any time to the end of Act 1. The reward is the quest's
// unique one (world-structure.md, 0069): a purse of 4,212 crowns, the
// company's number, in `clear_gold`.
(
    id: "side_company_ledger",
    map: "side_company_ledger",
    // The lane from Millhaven, south of the stream. Gil (1071) and Hedda
    // (0851) get slots here when they are units.
    player_slots: [
        (character: "lead", pos: (10, 12)),
        (character: "retainer", pos: (11, 12)),
        (character: "sergeant", pos: (12, 13)),
        (character: "poacher", pos: (9, 12)),
        (character: "keeper", pos: (10, 13)),
        (character: "heretic", pos: (11, 13)),
        (character: "defector", pos: (8, 13)),
    ],
    enemies: [
        // The gate: Hounds.
        (template: "hound_guard", pos: (14, 8), ai: Guard, level: Some(11)),
        (template: "hound_archer", pos: (13, 7), ai: Guard, level: Some(9)),
        (template: "hound_archer", pos: (15, 7), ai: Guard, level: Some(10)),
        (template: "hound_swordsman", pos: (14, 9), level: Some(10)),
        (template: "hound_rider", pos: (18, 9), level: Some(10)),
        // The west flank, round the wall's end: two of the Unpaid.
        (template: "red_archer", pos: (2, 7), ai: Guard, level: Some(11)),
        (template: "red_brigand", pos: (1, 9), level: Some(10)),
        // The yard: Red Company men on the paymaster's shilling.
        (template: "red_rider", pos: (8, 6), level: Some(10)),
        (template: "red_raider", pos: (12, 6), level: Some(10)),
        (template: "red_guard", pos: (11, 4), ai: Guard, level: Some(10)),
        // Denny Rudd on the barn step: holds it and comes no further.
        (character: "red_veteran", pos: (11, 5), ai: Guard),
        // Inside the barn.
        (template: "hound_guard", pos: (12, 3), ai: Guard, level: Some(10)),
        (template: "red_archer", pos: (15, 2), ai: Guard, level: Some(11)),
        // The strongroom: the paymaster and his guard.
        (character: "paymaster", pos: (6, 2), ai: Stationary, boss: true, defeat: Retreats),
        (template: "red_guard", pos: (8, 2), ai: Guard, level: Some(10)),
    ],
    // The county's riders, up the Millhaven road.
    reinforcements: [
        (turn: 4, unit: (template: "hound_rider", pos: (20, 9), level: Some(10))),
        (turn: 4, unit: (template: "hound_rider", pos: (20, 11), level: Some(10))),
    ],
    preparations: true,
    pack_cap: 4,
    // The debug Quick Battle: a Chapter 4 purse and some Potions.
    solo_stock: ["potion", "potion", "potion"],
    solo_gold: 1500,
    // The bots' army: who the player has by Chapter 4, at the level a
    // player reaches the barn with (docs/playtesting.md, *The army*).
    bots_army: (chapter: "ch04", level: 10),
    // The company's number: the quest's reward (side-tamsin.md).
    clear_gold: 4212,
    objective: DefeatUnit(unit: "paymaster", leftovers: Flee),
    // Scene ids and what each is written for: the top of dialogue/side_ledger.dlg.
    triggers: [
        (when: TurnStart(turn: 1, phase: Player), scene: "side_ledger_first_turn", once: true),
        (
            when: UnitEntersArea(who: Faction(Player), area: (x: 5, y: 1, w: 12, h: 3)),
            scene: "side_ledger_barn",
            once: true,
        ),
        (
            when: CombatStart(unit: "red_veteran", against: Some("sergeant")),
            scene: "side_ledger_veteran_engage_sergeant",
            once: true,
        ),
        (when: CombatStart(unit: "red_veteran"), scene: "side_ledger_veteran_engage", once: true),
        (when: UnitFell(unit: "red_veteran"), scene: "side_ledger_veteran_fell", once: true),
        (
            when: CombatStart(unit: "paymaster", against: Some("sergeant")),
            scene: "side_ledger_boss_engage_sergeant",
            once: true,
        ),
        (when: CombatStart(unit: "paymaster"), scene: "side_ledger_boss_engage", once: true),
        (when: HalfHp(unit: "paymaster"), scene: "side_ledger_boss_half", once: true),
        (when: UnitFell(unit: "paymaster"), scene: "side_ledger_boss_retreat", once: true),
        (when: UnitFell(unit: "lead"), scene: "side_ledger_death_lead", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Classic)), scene: "side_ledger_death_retainer", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Casual)), scene: "side_ledger_retreat_retainer", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Classic)), scene: "side_ledger_death_sergeant", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Casual)), scene: "side_ledger_retreat_sergeant", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Classic)), scene: "side_ledger_death_poacher", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Casual)), scene: "side_ledger_retreat_poacher", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Classic)), scene: "side_ledger_death_keeper", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Casual)), scene: "side_ledger_retreat_keeper", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Classic)), scene: "side_ledger_death_heretic", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Casual)), scene: "side_ledger_retreat_heretic", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Classic)), scene: "side_ledger_death_defector", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Casual)), scene: "side_ledger_retreat_defector", once: true),
    ],
    battle_notes: [
        (text: "The paymaster runs when he is beaten, and the men he pays run with him.", units: ["paymaster"]),
        (text: "Rudd holds the barn step and comes no further.", units: ["red_veteran"]),
    ],
    difficulty: Normal,
    kind: SideQuest,
    music: Cue("side_quest"),
    seed: 1072,
)
