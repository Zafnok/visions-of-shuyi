// Chapter 5's battle (ticket 0851; beat sheet docs/story/chapters/ch05.md):
// the envoy's house in Saltmere, sold to the Hounds by the magistrate.
// Hold it until first light: the battle is won when the last phase of turn
// 7 ends (turn-structure.md, *Survive*). The Hound officer need not fall.
// Every number here is a *the agent's starting value*, set by the bots
// (`cargo shuyi autobalance --stage ch05`) and judged in the Act 1
// playtest (1064).
//
// The house: the party in the street room behind the street door, Joss
// and Aske up the stair in the room at the top of the stairs, where Ragna
// is (off the map: behind her table with a knife). The Hounds come two
// ways: from the docks, along the quay to the street door, the officer
// with them; and over the roofs, three at the start, down the hatch at
// the top of the stairs or down the stairs at either end of the terrace
// to the quay. More come in boats to the piers and across the roofs from
// the streets behind, every other turn.
//
// Reached from the world map (worldmaps/act1.ron, `envoys_house`).
(
    id: "ch05",
    map: "ch05",
    // Hedda joins in ch05_prebattle, sent down to the street door. Gil's
    // slot stays empty unless he joined in Chapter 4 (1071).
    player_slots: [
        (character: "lead", pos: (13, 7)),
        (character: "shieldbearer", pos: (14, 7)),
        (character: "retainer", pos: (13, 6)),
        (character: "sergeant", pos: (11, 7)),
        (character: "poacher", pos: (15, 3)),
        (character: "keeper", pos: (15, 6)),
        (character: "heretic", pos: (12, 6)),
        (character: "defector", pos: (12, 3)),
        (character: "prizefighter", pos: (16, 7)),
    ],
    enemies: [
        // The quay, in front of the street door.
        (template: "hound_swordsman", pos: (9, 10), level: Some(8)),
        (template: "hound_raider", pos: (17, 10), level: Some(8)),
        (template: "hound_guard", pos: (12, 11), level: Some(8)),
        (template: "hound_archer", pos: (15, 11), level: Some(8)),
        // The docks: the officer comes up the sea steps with his men.
        (character: "hound_officer", pos: (13, 13), boss: true),
        (template: "hound_swordsman", pos: (14, 13), level: Some(8)),
        // Black on three roofs.
        (template: "hound_raider", pos: (7, 1), level: Some(8)),
        (template: "hound_archer", pos: (20, 1), level: Some(8)),
        (template: "hound_swordsman", pos: (24, 5), level: Some(8)),
    ],
    reinforcements: [
        // Boats to the piers.
        (turn: 2, unit: (template: "hound_raider", pos: (5, 15), level: Some(8))),
        (turn: 2, unit: (template: "hound_swordsman", pos: (22, 15), level: Some(8))),
        // Across the roofs from the streets behind.
        (turn: 3, unit: (template: "hound_swordsman", pos: (0, 0), level: Some(8))),
        (turn: 3, unit: (template: "hound_raider", pos: (27, 0), level: Some(8))),
        (turn: 4, unit: (template: "hound_guard", pos: (13, 15), level: Some(8))),
        (turn: 4, unit: (template: "hound_archer", pos: (14, 15), level: Some(8))),
        (turn: 5, unit: (template: "hound_archer", pos: (0, 0), level: Some(8))),
        (turn: 5, unit: (template: "hound_swordsman", pos: (27, 0), level: Some(8))),
    ],
    preparations: true,
    pack_cap: 3,
    // The debug Quick Battle: about what Chapter 4 leaves (the stock and
    // gold Chapter 3 left, and Chapter 4's 1800 gold).
    solo_stock: ["potion", "potion", "potion", "houndmasters_axe", "fordwardens_spear", "elixir", "elixir", "focus_charm"],
    solo_gold: 5500,
    clear_gold: 2000,
    objective: Survive(turns: 7),
    // Scene ids and what each is written for: the top of dialogue/ch05.dlg.
    triggers: [
        (when: TurnStart(turn: 1, phase: Player), scene: "ch05_first_turn", once: true),
        // Anyone of the party out of the hatch onto the roofs.
        (
            when: UnitEntersArea(who: Faction(Player), area: (x: 0, y: 0, w: 28, h: 2)),
            scene: "ch05_roof",
            once: true,
        ),
        (
            when: CombatStart(unit: "hound_officer", against: Some("defector")),
            scene: "ch05_boss_engage_defector",
            once: true,
        ),
        (when: CombatStart(unit: "hound_officer"), scene: "ch05_boss_engage", once: true),
        (when: HalfHp(unit: "hound_officer"), scene: "ch05_boss_half", once: true),
        (when: UnitFell(unit: "hound_officer"), scene: "ch05_boss_fell", once: true),
        (when: UnitFell(unit: "lead"), scene: "ch05_death_lead", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Classic)), scene: "ch05_death_retainer", once: true),
        (when: UnitFell(unit: "retainer", mode: Some(Casual)), scene: "ch05_retreat_retainer", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Classic)), scene: "ch05_death_sergeant", once: true),
        (when: UnitFell(unit: "sergeant", mode: Some(Casual)), scene: "ch05_retreat_sergeant", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Classic)), scene: "ch05_death_poacher", once: true),
        (when: UnitFell(unit: "poacher", mode: Some(Casual)), scene: "ch05_retreat_poacher", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Classic)), scene: "ch05_death_keeper", once: true),
        (when: UnitFell(unit: "keeper", mode: Some(Casual)), scene: "ch05_retreat_keeper", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Classic)), scene: "ch05_death_heretic", once: true),
        (when: UnitFell(unit: "heretic", mode: Some(Casual)), scene: "ch05_retreat_heretic", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Classic)), scene: "ch05_death_defector", once: true),
        (when: UnitFell(unit: "defector", mode: Some(Casual)), scene: "ch05_retreat_defector", once: true),
        (
            when: UnitFell(unit: "prizefighter", mode: Some(Classic)),
            scene: "ch05_death_prizefighter",
            once: true,
        ),
        (
            when: UnitFell(unit: "prizefighter", mode: Some(Casual)),
            scene: "ch05_retreat_prizefighter",
            once: true,
        ),
        (
            when: UnitFell(unit: "shieldbearer", mode: Some(Classic)),
            scene: "ch05_death_shieldbearer",
            once: true,
        ),
        (
            when: UnitFell(unit: "shieldbearer", mode: Some(Casual)),
            scene: "ch05_retreat_shieldbearer",
            once: true,
        ),
    ],
    // The first Survive in the story: what wins it, and the two ways in.
    battle_notes: [
        (text: "Hold the house until first light. The officer need not fall.", units: ["hound_officer"]),
        (text: "Two ways in: the street door, and the roof hatch at the top of the stairs."),
    ],
    difficulty: Normal,
    music: Cue("battle_night_siege"),
    seed: 851,
)
