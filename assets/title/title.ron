// The title screen's art (ticket 0811, ADR-0059). Format: README.md here.
// One of the backdrops is behind the logo each launch.
(
    logo: "logo.png",
    // The words on the Game Over screen, in the logo's lettering (0830).
    game_over: Some("game_over.png"),
    // The chapter title card's lettering (0812): Cinzel, baked by
    // `cargo xtask lettering` into chapter_name.{png,ron} and
    // chapter_line.{png,ron} here.
    lettering: Some((heading: "chapter_name", line: "chapter_line")),
    // The campfire in the bottom-left corner, four frames side by side
    // (ticket 0922; Idylwild's Chromatic Campfires, CC0).
    campfire: Some((file: "campfire.png", frames: 4)),
    backdrops: [
        "fields_a_dusk.png",
        "fields_a_night.png",
        "fields_b_day.png",
        "fields_b_dusk.png",
        "fields_b_night.png",
        "meadows_dusk.png",
        "meadows_night.png",
    ],
)
