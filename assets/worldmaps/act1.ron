        "~~       .     ,     fww.    .  ,      . t, ftff  .,    ,^ ^^A^^ ^^^^^",
        "~~          . .. . .  ww       .,   ,    f.fftttf.   .     ^A^^^A^^^.^",
        "~~ , ,     , .  ,     ww        .   , .  ff ,ff   ,      , ^^^^A^^^A^^",
