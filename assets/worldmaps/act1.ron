        "~~ .tf ,tfft  ftff, t ww       ..  ,   fff  ff            ,         , ",
        "~~  ~wwww ffff tttf.. ww, .  .     . .   ff f   ,  , .  .   .  ,, .   ",
        "~~~wwwwwwwfttf.f.fft  ww   , , .  ,  ,   . f .         ,     ,        ",
        "~~~wwwwwwwwwftftf , , .ww    .    , .,      ..       ,.     ,         ",
        "~~~~wwwwwwww  f     , ww~~~~~~~~ ,       ..   .       ,  .   .    ,,. ",
        "~~~~~www   ,        ,  .~~~~~~~~   ,.  ., .    ,    ,   ,, ,. , ,.    ",
        "~~~~~~~~~ ,.  . , ~~~~~~~~~~~~~~,   ~~~~~~~~~~~~~~~~~~~~~~~~~~~      ,",
        "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",
    ],
)
