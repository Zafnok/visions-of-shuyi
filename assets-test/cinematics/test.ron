// TEST FILE: the cinematic the tests and the debug menu's "Play test
// cinematic" play (tickets 0817, 0827): a pan over the test battle's map,
// on which the lead walks up to the brigand and fells it with two
// strikes, then the logo. Ten seconds long, on no music.
(
    id: "test",
    length: Seconds(10.0),
    actions: {
        "duel": [
            (at: 0.5, do: Walk(unit: "lead", path: [(3, 5), (3, 3), (7, 3)], secs: 3.0)),
            (at: 4.0, do: Strike(unit: "lead", target: "road_brigand", hp_left: 40)),
            (at: 5.0, do: Strike(unit: "lead", target: "road_brigand", hp_left: 0)),
        ],
    },
    shots: [
        (at: 0.0, shot: MapPan(battle: "test", from: (5.75, 3.5), to: (7.25, 3.5), zoom: 4, action: "duel")),
        (at: 6.0, shot: Logo),
    ],
)
