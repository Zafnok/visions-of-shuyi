{
  "name": "dlg",
  "displayName": "Visions of Shuyi scripts (.dlg)",
  "description": "Colors and indenting for the game's .dlg dialogue scripts.",
  "publisher": "visions-of-shuyi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dlg",
        "aliases": [
          "Dialogue script",
          "dlg"
        ],
        "extensions": [
          ".dlg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dlg",
        "scopeName": "source.dlg",
        "path": "./syntaxes/dlg.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[dlg]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.wordWrap": "on",
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
      }
    }
  }
}
