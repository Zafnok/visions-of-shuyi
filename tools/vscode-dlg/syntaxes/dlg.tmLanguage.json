{
  "$comment": "The game's .dlg dialogue format (assets/dialogue/README.md), translated rule for rule from Shuyi Engine's site/syntaxes/dlg.sublime-syntax (MIT OR Apache-2.0), plus name tokens ({n:id}, {N:id}, {lead}) inside the text.",
  "name": "Dialogue script",
  "scopeName": "source.dlg",
  "fileTypes": ["dlg"],
  "patterns": [
    { "match": "^\\s*#.*$", "name": "comment.line.dlg" },
    { "match": "^\\s*@[A-Za-z]+", "name": "keyword.control.dlg" },
    { "match": "^\\s*>", "name": "keyword.operator.dlg" },
    { "match": "^\\*", "name": "keyword.operator.dlg" },
    { "match": "(?<=^\\* )[A-Za-z0-9_-]+(?=:)", "name": "entity.name.tag.dlg" },
    {
      "match": "^\\s*[A-Za-z0-9_-]+(?=(?:\\[[^\\]]*\\])?(?: \\([^)]*\\))?:)",
      "name": "entity.name.tag.dlg"
    },
    {
      "match": "(?<=[A-Za-z0-9_-])\\[[^\\]]*\\](?=(?: \\([^)]*\\))?:)",
      "name": "constant.other.dlg"
    },
    {
      "match": "\\{(?:[nN]:[^{}|\\s]+|lead(?:\\|[^{}]*)?)\\}",
      "name": "variable.other.name.dlg"
    }
  ]
}
