        // The game embeds its files in the program: no package holds a pack.
        allowed_pack_entries: [],
        // The test files (ADR-0057), as files and as the names they have when
        // embedded, and the bought art's raw library and originals (ADR-0040).
        forbidden_paths: [
            "assets-test/lang/test/ui.ron",
            "lang/test/ui.ron",
            "dialogue/test_act1.dlg",
            "portraits/test_lord.ron",
            "assets-private/library",
            "library/tiny-tales",
            "assets-private/originals",
        ],
        // From the `test` language pack and the test characters. They find what
        // is written plainly: this guards against mistakes, not a player digging.
        canaries: [
            "BLOCKS THE PATH UNTIL WON",
            "id: \"test_knight\", class: \"guard\"",
        ],
    ),

    // The Chapter 1 demo (ticket 0914, ADR-0117): `cargo shuyi export web
    // --release --edition demo`. Its program embeds what
    // `crates/content/demo/bundle.txt` keeps of `assets/` and the bought art
    // (the content root, handed to `crates/content/build.rs` as
    // SHUYI_CONTENT), and ends after Chapter 1 (`docs/design/demo.md`). Its
    // packages are held to its own part: the files the full game's may hold
    // on Windows and the web (an xtask test keeps the two lists in step),
    // and canaries that are ids and file names of what comes after Chapter 1,
    // never script lines (this file is public). A shared file that starts
    // naming a later chapter fails the demo's export with SH3012 in CI.
    editions: {
        "demo": (
            default_features: false,
            features: ["private-assets"],
            content: "crates/content/demo",
            disclosure: (
                allowed_files: [
