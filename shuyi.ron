// Shuyi Engine's project file (ticket 1117): what `cargo shuyi <command>`
// (the engine's tools, `shuyi-cli`, run by xtask with this game's; ticket
// 1131) scans and builds in this repository. Paths are from this folder. `cargo xtask` still takes the
// old names of these commands and runs them with this file.
(
    command: "cargo shuyi",

    // Who the game is (ticket 1199): `cargo shuyi app-info` writes it into
    // `code`. The version is the package's, which `release.yml` tags. Never
    // change `storage`, or every player's saves are lost
    // (`%APPDATA%/tactical-rpg`, `localStorage` keys under `tactical-rpg/`).
    app: (
        name: "Visions of Shuyi",
        id: "com.zafnok.visionsofshuyi",
        storage: "tactical-rpg",
        code: "crates/app/src/app_info.rs",
        icon: "assets-src/icon/icon.png",
        window_icons: "crates/app/icon",
        icon_sizes: {
            16: "assets-src/icon/icon-16.png",
            32: "assets-src/icon/icon-32.png",
        },
    ),

    // The game's tool program: every command that runs the game
    // (`frame-png`, `lang-status`, `run`, `scene`, the MCP server's
    // session) runs in xtask as `cargo run -p xtask -- shuyi <command>`,
    // the engine's tools with the game's (crates/xtask/src/game_tools.rs;
    // ticket 1181). For a picture of the bought art:
    // `cargo run -p xtask --features private-assets -- frame-png …`.
    game: (package: "xtask", args: ["shuyi"]),

    // The pure rules (ADR-0004): `lint` fences this package.
    rules: Some("trpg-core"),

    // The Playdate's front end is the game's own crate (ADR-0070), built by
    // `cargo xtask playdate`, and its buttons are named as that crate reports
    // them (crates/playdate/src/pads.rs), so its profile is the game's too
    // (ticket 0140). This check reads only a profile's display and input.
    target_profiles: Some("targets"),

    // What `check --target` checks the game against (ticket 0138): the sizes
    // are `ConsoleSpec::PC` and `ConsoleSpec::PLAYDATE`
    // (crates/ui/src/console.rs), with cells 16 px tall.
    targets: {
        "desktop": (frame: (800, 512), scale: integer, text_px: 16),
        "web": (frame: (800, 512), scale: integer, text_px: 16),
        "playdate": (frame: (400, 240), scale: integer, text_px: 16),
    },

    // Keys hard-coded in game code or text (ticket 0216, the
    // keyboard-input skill).
    check_keys: (
        rust: ["crates/ui/src", "crates/app/src", "crates/content/src", "crates/playdate/src"],
        // The story's files and the test files (ADR-0057).
        assets: ["assets", "assets-test"],
        not_text: ["assets/data/keymap.ron"],
        // The key pipeline. The Playdate's `pads.rs` reads its buttons
        // (ticket 1033). The engine's keymap format, input and platform
        // shell are in the engine's repository (ticket 1131).
        key_files: [
            "crates/content/src/keymap.rs",
            "crates/ui/src/input.rs",
            "crates/playdate/src/pads.rs",
        ],
        // The only file that may read macroquad's keyboard: the engine's
        // platform shell, so none that this check scans (it names no file
        // here).
        platform_file: "shuyi-app's src/keys.rs (Shuyi Engine)",
        test_support: ["crates/ui/src/harness.rs"],
        // The layout picker and its skin may draw a keyboard. Since ticket
        // 1112 both are the engine's and the game's `layout_picker.rs`
        // names no key; these keep the game's own picture, should it draw
        // one again, to these two files.
        picture_files: [
            "crates/ui/src/screens/layout_picker.rs",
            "crates/ui/src/screens/layout_picker/glyph.rs",
        ],
        hint: "use an Action and `widgets::help::key_name`; see the keyboard-input skill",
    ),

    // Screen text written as literals, and screens reading a data name
    // (tickets 0233, 0235, ADR-0045).
    check_text: (
        dir: "crates/ui/src",
        // None since ticket 0243: every screen asks for its text by key.
        max_literals: 0,
        words_file: "crates/ui/src/words.rs",
        // The debug screens (developers', English only) and the snapshots'
        // text form.
        skip: ["crates/ui/src/debug.rs", "crates/ui/src/debug/", "crates/ui/src/snapshot.rs"],
        test_support: ["crates/ui/src/harness.rs"],
        hint: "put the text in assets/lang/en/ui.ron and ask for it with `ctx.text(\"screen.thing\")`",
        name_hint: "show the name through `ctx.words()` (crates/ui/src/words.rs), or mark a view's own field with `// check-text: not a data name`",
    ),

    // The glyphs the game's content requires (trpg_content::font::
    // REQUIRED_GLYPHS; an xtask test keeps the two equal).
    font_atlas: (
        required_glyphs: " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~¡¢£¤¥¦§¨©ª«¬\u{ad}®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ─│┌┐└┘├┤┬┴┼═║╔╗╚╝╠╣╦╩╬░▒▓█▀▄▌▐■♣♠♥♦≈•ˇ▲▼◄►←↑→↓☺☻♪†╱╲╤╫∩≡◊☖☗⛨⛩♔♕",
        readme: "assets/fonts/README.md",
    ),

    // The web build (tickets 0206, 0207, 0219): `--debug-tools` for the
    // Pages build (ADR-0023), `--private-assets` for the bought art
    // (ADR-0040). Music (ADR-0026) and voices (ADR-0046) ship beside it.
    web: (
        package: "trpg-app",
        bin: "visions-of-shuyi",
        title: "Visions of Shuyi",
        features: ["debug-tools", "private-assets"],
        music: "music",
        voice: "voice",
        dist: "dist/web",
    ),

    // What `NOTICES.txt` adds to the crates and the engine's files (ticket
    // 0909): the game's own works and their license texts. An xtask test
    // keeps them in step with THIRD_PARTY_ASSETS.md and the audio manifest.
    notices: (texts: [
        "assets/NOTICES-game.txt",
        "assets/fonts/Terminus-LICENSE.txt",
        "assets/audio/licenses/CC0-1.0.txt",
        "assets/audio/licenses/CC-BY-4.0.txt",
        "assets/audio/licenses/CC-BY-3.0.txt",
    ]),

    // What `cargo shuyi export` builds and ships for `release.yml` (ticket
    // 0910). A build without the bought art passes `--without private-assets`.
    // The licenses report is cargo-about's, made first (docs/releasing.md).
    // On the web, `music` and `voice` come with the web build.
    export: (
        package: "trpg-app",
        features: ["private-assets"],
        beside: [
            (path: "assets-src/package/README.txt"),
            (path: "LICENSE"),
            (path: "THIRD_PARTY_ASSETS.md"),
            (path: "dist/licenses/THIRD_PARTY_LICENSES.html"),
            (path: "assets/fonts/Terminus-LICENSE.txt"),
            (path: "assets/audio/licenses", name: "audio-licenses"),
            (path: "music"),
            (path: "voice", optional: true),
        ],
        // A release web export ships the Wasm as built when Binaryen's
        // `wasm-opt` isn't installed, with a warning, as it did before engine
        // #331 refused that: no runner installs it yet (ticket 0916).
        wasm_opt: optional,
    ),

    // What a release package may hold (ticket 1208): an export that breaks
    // this is refused with SH3012 and its package removed. Paths match whole
    // and the part is one for every target, so a folder of `export.beside` is
    // listed twice, as `.app` bundles put it in Resources. A new track or voice
    // clip needs its two lines (an xtask test checks `music/`, the audio
    // licenses and, when the private repository's copy is here, every file of
    // `voice/`). The program, `NOTICES.txt` and the web page need none, and the
    // bought art is inside the program, so it needs none either.
    disclosure: (
        allowed_files: [
            "LICENSE",
            "README.txt",
            "THIRD_PARTY_ASSETS.md",
            "THIRD_PARTY_LICENSES.html",
            "Terminus-LICENSE.txt",
            "audio-licenses/CC-BY-3.0.txt",
            "audio-licenses/CC-BY-4.0.txt",
            "audio-licenses/CC0-1.0.txt",
            "music/a_slave_to_no_one.ogg",
            "music/adventures_in_adventureland.ogg",
            "music/aria.ogg",
            "music/bards_tale.ogg",
            "music/battle_mla.ogg",
            "music/battle_music.ogg",
            "music/battle_theme_a.ogg",
            "music/battle_theme_b.ogg",
            "music/classical_murder.ogg",
            "music/dark_forest_theme.ogg",
            "music/dark_quest.ogg",
            "music/determined_pursuit_loop.ogg",
            "music/ending_scene_orchestral.ogg",
            "music/epic_endgame_cinematic.ogg",
            "music/fantasy_choir_2.ogg",
            "music/fantasy_choir_3.ogg",
            "music/fathers_scabbard_loop.ogg",
            "music/field_orchestra.ogg",
            "music/hesitation_orchestral.ogg",
            "music/hope_orchestral_battle.ogg",
            "music/new_sunrise_v1.ogg",
            "music/new_sunrise_v2.ogg",
