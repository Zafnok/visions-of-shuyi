// `cargo shuyi bench`'s scenarios (ticket 1244; the engine's
// docs/targets/README.md, the game's docs/targets.md): each is played
// headless, and its frames' instructions, its heap's peak and the
// package are gated against the budgets of every target `shuyi.ron`
// lists. The steps press the game's actions by name, so they hold for
// any key layout and for the Playdate's buttons.
//
// The cursor swept round the biggest battle's map, from the lead: up to
// the top, across, down and back. The view follows it, and the side
// panel shows each tile and unit it passes.
(
    format_version: 1,
    about: "the cursor sweeping the biggest battle's map",
    start: [(flag: "--battle", value: "side_company_ledger")],
    script: (steps: [
        act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"),
        act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"), act("CursorUp"),
        act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"),
        act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"), act("CursorRight"),
        act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"),
        act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"), act("CursorDown"),
        act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"),
        act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"), act("CursorLeft"),
    ]),
    frames: 10,
)
