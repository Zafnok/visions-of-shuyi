// The playtest personas (ticket 0506, docs/playtesting.md, ADR-0095): dev
// tooling, not game content. Each is the engine's rollout bot with these
// settings, read by `cargo xtask playtest`.
//
// Chosen from the persona descriptions in docs/design/playtest-bots.md and
// FIXED: never tuned to make a battle pass. Only the comparison with
// Nick's own play (ticket 0508) may change them, and never per battle.
//
// A persona plans its own turn (the engine's turn planner, engine#2128):
// short sequences of its own commands ("weaken it, then finish it"), each
// played on a few copies of the battle with fresh luck and scored where
// the copy got to. It plays again for its next command. It never plays
// the enemy's turn out: like a player, it knows the danger zone and the
// forecasts, not whom the enemy will choose (Nick, 2026-10-21).
//
// settings (how it thinks; skill = thinking budget + mistakes):
//   width        partial turns kept at each step, to extend at the next
//   candidates   commands tried from each partial turn (attacks first, see
//                trpg_bots::order)
//   depth        the most of its own commands a plan holds
//   samples      copies each partial turn is played on (fresh luck each)
//   temperature  how far its pick may stray, in points: a command this
//                many points below the best is half as likely; 0 = always
//                the best
//
// weights (what it cares about): points per thing counted, added up; a
// cost is negative.
//   won, lost             the battle won or lost
//   lord_fell, unit_fell  a lord, another player unit fallen
//   hp_lost, lord_hp_lost HP lost in the candidate's own fight (a heal
//                         counts back)
//   enemy_fell            an enemy fallen
//   progress              enemy HP taken in a rout (the boss's in a boss
//                         fight, a tile closer in a seize)
//   approach              a tile the units came closer to the nearest
//                         enemy (the boss, the tile to seize), walking
//   exposed, lord_exposed HP the enemies that can reach a unit are
//                         expected to take from it next phase, by the
//                         forecast
//   at_risk, lord_at_risk a unit that falls if every enemy that can reach
//                         it strikes and hits
//   counter               HP the units are expected to strike back at the
//                         enemies that can reach them, by the forecast
//   turns                 a turn that began
//   items                 a pack item used
//   houses                a house saved, less a house burned, in a battle
//                         with a village goal (0313); the same for every
//                         persona, added with the rule, not tuned
{
    // Plays in Casual mode and cares about winning and the lord. A fall
    // doesn't upset it ("the # of deaths does not influence bot at all"),
    // but its units are tools it needs to win (Nick, 2026-10-22): a fall
    // costs a tenth of a win, a unit left where it could fall a third of
    // that; their HP doesn't count. It weighs as many commands at each
    // step as Normal (a casual player still moves all their units), but
    // plans only two ahead, keeps few plans on few copies, and strays. Plans two commands ahead, a narrow plan on few copies,
    // and it strays: a casual player.
    "casual": (
        mode: Casual,
        settings: (
            width: 2,
            candidates: 10,
            depth: 2,
            samples: 2,
            temperature: 100,
        ),
        weights: (
            won: 10000,
            lost: -10000,
            lord_fell: -10000,
            unit_fell: -1000,
            hp_lost: 0,
            lord_hp_lost: -20,
            enemy_fell: 100,
            progress: 10,
            approach: 2,
            exposed: 0,
            lord_exposed: -20,
            at_risk: -300,
            lord_at_risk: -5000,
            counter: 10,
            turns: 0,
            items: 0,
            houses: 500,
        ),
    ),
    // Plays Classic and wants nobody dead: a fallen unit costs more than a
    // win is worth, and so does leaving one where it could fall. HP costs
    // half of what the enemy's HP is worth (a heal brings it back; an
    // enemy's HP is gone for good). Spends items when that helps (a heal of
    // 10 HP is worth an item), doesn't hurry. Plans three commands ahead,
    // strays a little.
    "normal": (
        mode: Classic,
        settings: (
            width: 4,
            candidates: 10,
            depth: 3,
            samples: 4,
            temperature: 25,
        ),
        weights: (
            won: 10000,
            lost: -10000,
            lord_fell: -10000,
            unit_fell: -15000,
            hp_lost: -5,
            lord_hp_lost: -5,
            enemy_fell: 100,
            progress: 10,
            approach: 2,
            exposed: -5,
            lord_exposed: -5,
            at_risk: -3000,
            lord_at_risk: -5000,
            counter: 10,
            turns: 0,
            items: -50,
            houses: 500,
        ),
    ),
    // Plays Classic like a veteran: nobody dead, few turns, few items, and
    // plays better than Normal ("hardcore should play better than
    // normal"): plans four commands ahead, keeps twice as many plans on
    // more copies, never strays, and presses harder (enemies and progress
    // are worth more). It won't spend items, so it guards its HP twice as
    // hard as Normal (Nick, 2026-10-22: fewer potions).
    "hardcore": (
        mode: Classic,
        settings: (
            width: 8,
            candidates: 12,
            depth: 4,
            samples: 6,
            temperature: 0,
        ),
        weights: (
            won: 10000,
            lost: -10000,
            lord_fell: -10000,
            unit_fell: -15000,
            hp_lost: -10,
            lord_hp_lost: -10,
            enemy_fell: 150,
            progress: 15,
            approach: 3,
            exposed: -10,
            lord_exposed: -10,
            at_risk: -3000,
            lord_at_risk: -5000,
            counter: 15,
            turns: -200,
            items: -300,
            houses: 500,
        ),
    ),
}
